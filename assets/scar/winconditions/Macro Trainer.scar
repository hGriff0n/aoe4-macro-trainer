-----------------------------------------------------------------------
-- Modding Required Functions
-----------------------------------------------------------------------

-- Global data table that can be referenced in script functions
_mod = {
	module = "Mod",
}

-- Register the win condition (Some functions can be prepended with "Mod_" to be called automatically as part of the scripting framework)
Core_RegisterModule(_mod.module)

-- Called before initialization (ie. before `OnInit`)
function Mod_PreInit()
	-- TODO: Do I have to do this?
	-- Enable Tribute UI
	-- Core_CallDelegateFunctions("TributeEnabled", true)
end

-- Called on match initialization before handing control to the player
function Mod_OnInit()
	local options_selected = {}
	-- TODO: Is this required
	Setup_GetWinConditionOptions(options_selected)
	Slowdown_InitFromSettings(options_selected)
	BuildOrder_OnInit()
end

-- Called after initialization is done when game is fading up from black
function Mod_Start()
	-- Because BuildOrder needs to spawn a "select build order" ui modal
	-- It must run first and then call whatever other start hooks
	BuildOrder_OnGameStart([Slowdown_Start])
end

-- Called when Core_SetPlayerDefeated() is invoked.
-- Signals that a player has been eliminated from play due to defeat.
function Mod_OnPlayerDefeated(player, reason)
end

-- Called by `Core_OnGameOver()` when that the match is about to end.
-- Generally used for clean up of mod-specific elements
function Mod_OnGameOver()
	BuildOrder_Stop()
	Slowdown_Stop()
end
