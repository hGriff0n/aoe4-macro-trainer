-----------------------------------------------------------------------
-- Imported Scripts
-----------------------------------------------------------------------

-- Import Utility Scripts
import("cardinal.scar")							-- Contains sfx references, UI templates, and Civ/Age helper functions
import("ScarUtil.scar")							-- Contains game helper functions
import("generated/build_orders.scar")
import("build_orders/objective_engine.scar")

-- Import Gameplay Systems
import("gameplay/score.scar")					-- Tracks player score
import("gameplay/diplomacy.scar")				-- Manages Tribute

-- Import Win Conditions
import("winconditions/annihilation.scar")		-- Support for eliminating a player when they can no longer fight or produce units
import("winconditions/elimination.scar")		-- Support for player quitting or dropping (through pause menu or disconnection)
import("winconditions/surrender.scar")			-- Support for player surrender (through pause menu)

-- Import UI Support
import("gameplay/chi/current_dynasty_ui.scar")	-- Displays Chinese Dynasty UI
import("gameplay/event_cues.scar")
import("gameplay/currentageui.scar")

-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

-- Global data table that can be referenced in script functions (e.g. _mod.module = "Mod")
_mod = {
	module = "Mod",
	phaseObjective = nil,
	phaseStartTime = nil,
	phaseDeadline = nil,
	normalPhaseDuration = nil,
	slowPhaseDuration = nil,
	normalDurationSeconds = 45,
	slowDurationSeconds = 15,
	slowSimRate = 1,
}

NORMAL_SIM_RATE = 8
NORMAL_PHASE_OBJECTIVE_TITLE = "$dfb5645698a84afb91cf7a2dfb0f4a4e:4"
SLOW_PHASE_OBJECTIVE_TITLE = "$dfb5645698a84afb91cf7a2dfb0f4a4e:5"

SLOW_SIM_RATES = {
	slow_sim_rate_1 = 1,
	slow_sim_rate_2 = 2,
	slow_sim_rate_3 = 3,
	slow_sim_rate_4 = 4,
	slow_sim_rate_5 = 5,
	slow_sim_rate_6 = 6,
	slow_sim_rate_7 = 7,
}

-- Register the win condition (Some functions can be prepended with "Mod_" to be called automatically as part of the scripting framework)
Core_RegisterModule(_mod.module)

-----------------------------------------------------------------------
-- Scripting framework 
-----------------------------------------------------------------------

-- Called during load as part of the game setup sequence
function Mod_SetupSettings(options)
	if options == nil or options.section_macro_trainer_settings == nil then
		return
	end

	local settings = options.section_macro_trainer_settings
	if settings.option_normal_duration_seconds ~= nil then
		_mod.normalDurationSeconds = math.max(1, math.min(300, settings.option_normal_duration_seconds))
	end
	if settings.option_slow_duration_seconds ~= nil then
		_mod.slowDurationSeconds = math.max(1, math.min(300, settings.option_slow_duration_seconds))
	end
	if SLOW_SIM_RATES[settings.option_slow_sim_rate] ~= nil then
		_mod.slowSimRate = SLOW_SIM_RATES[settings.option_slow_sim_rate]
	end
end

-- Called before initialization, preceding other module OnInit functions
function Mod_PreInit()
	
	-- Enable Tribute UI
	Core_CallDelegateFunctions("TributeEnabled", true)
	
end

-- Called on match initialization before handing control to the player
function Mod_OnInit()
	
	
	
end

-- Called after initialization is done when game is fading up from black
function Mod_Start()
	_mod.normalPhaseDuration = math.ceil(_mod.normalDurationSeconds * NORMAL_SIM_RATE / NORMAL_SIM_RATE)
	_mod.slowPhaseDuration = math.ceil(_mod.slowDurationSeconds * _mod.slowSimRate / NORMAL_SIM_RATE)
	Mod_StartPhase(NORMAL_PHASE_OBJECTIVE_TITLE, _mod.normalPhaseDuration, NORMAL_SIM_RATE, Mod_EnterSlowSpeed)
end

function Mod_EnterSlowSpeed()
	Mod_StartPhase(SLOW_PHASE_OBJECTIVE_TITLE, _mod.slowPhaseDuration, _mod.slowSimRate, Mod_EnterNormalSpeed)
end

function Mod_EnterNormalSpeed()
	Mod_StartPhase(NORMAL_PHASE_OBJECTIVE_TITLE, _mod.normalPhaseDuration, NORMAL_SIM_RATE, Mod_EnterSlowSpeed)
end

function Mod_ClearPhaseObjective()
	if _mod.phaseObjective ~= nil then
		Objective_StopTimer(_mod.phaseObjective)
		Objective_Expire(_mod.phaseObjective, false, false)
		_mod.phaseObjective = nil
	end
end

function Mod_StartPhase(title, phaseDuration, simRate, nextRule)
	Mod_ClearPhaseObjective()
	_mod.phaseStartTime = World_GetGameTime()
	_mod.phaseDeadline = _mod.phaseStartTime + phaseDuration

	local objective = {
		Title = title,
		Description = Loc_Empty(),
		Type = OT_Information,
	}

	Objective_Register(objective)
	Objective_Start(objective, false, false)
	Objective_StartTimer(objective, COUNT_DOWN, phaseDuration, 0)
	_mod.phaseObjective = objective

	Misc_SetSimRate(simRate)
	Rule_Remove(nextRule)
	Rule_AddOneShot(nextRule, phaseDuration)
end

-- Called when Core_SetPlayerDefeated() is invoked. Signals that a player has been eliminated from play due to defeat.
function Mod_OnPlayerDefeated(player, reason)
	
	
	
end

-- When a victory condition is met, a module must call Core_OnGameOver() in order to invoke this delegate and notify all modules that the match is about to end. Generally used for clean up (removal of rules, objectives, and UI elements specific to the module).
function Mod_OnGameOver()
	Rule_Remove(Mod_EnterSlowSpeed)
	Rule_Remove(Mod_EnterNormalSpeed)
	Mod_ClearPhaseObjective()
	Misc_SetSimRate(NORMAL_SIM_RATE)
end
