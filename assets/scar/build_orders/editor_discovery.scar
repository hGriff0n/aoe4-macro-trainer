BUILD_ORDER_DISCOVERY_DEFAULT_ICONS = {
	building = "/WPFGUI;component/icons/objectives/objectives_generic_small.png",
	squad = "/WPFGUI;component/icons/garrisoned_unit.png",
	technology = "/WPFGUI;component/images/fe/achievement.png",
	age_up = "/WPFGUI;component/icons/objectives/objectives_generic_small.png",
	family = "/WPFGUI;component/icons/garrisoned_unit.png",
}

BUILD_ORDER_DISCOVERY_LISTS = {
	building = "buildings",
	squad = "squads",
	technology = "technologies",
	age_up = "age_ups",
	family = "families",
	-- Compatibility aliases keep already-open drafts readable while every live editor
	-- adapter consumes one of the dedicated semantic lists above.
	entity = "buildings",
	upgrade = "technologies",
}

BUILD_ORDER_DISCOVERY_CURRENT = nil

BUILD_ORDER_DISCOVERY_CIV_ALIASES = {
	abbasid = "abbasid",
	abbasid_ha_01 = "abbasid",
	ayyubid = "ayyubids",
	ayyubid_cmp = "ayyubids",
	ayyubids = "ayyubids",
	byzantine = "byzantines",
	byzantine_ha_mac = "macedonian_dynasty",
	byzantines = "byzantines",
	chinese = "chinese",
	chinese_ha_01 = "zhu_xi",
	chinese_ha_jin = "jin_dynasty",
	delhi = "delhi",
	english = "english",
	english_ha_01 = "house_of_lancaster",
	french = "french",
	french_ha_01 = "jeanne_darc",
	golden_horde = "golden_horde",
	house_of_lancaster = "house_of_lancaster",
	hre = "hre",
	hre_ha_01 = "order_of_the_dragon",
	japanese = "japanese",
	japanese_ha_01 = "sengoku_daimyo",
	jeanne_darc = "jeanne_darc",
	jin_dynasty = "jin_dynasty",
	macedonian_dynasty = "macedonian_dynasty",
	malian = "malians",
	malians = "malians",
	mongol = "mongols",
	mongol_ha_gol = "golden_horde",
	mongols = "mongols",
	order_of_the_dragon = "order_of_the_dragon",
	ottoman = "ottomans",
	ottomans = "ottomans",
	rus = "rus",
	sengoku_daimyo = "sengoku_daimyo",
	sultanate_ha_tug = "tughlaq_dynasty",
	templar = "templar",
	tughlaq_dynasty = "tughlaq_dynasty",
	zhu_xi = "zhu_xi",
}

function BuildOrderDiscovery_CanonicalCivID(raceName)
	if type(raceName) ~= "string" then
		return ""
	end
	local normalized = string.lower(raceName)
	return BUILD_ORDER_DISCOVERY_CIV_ALIASES[normalized] or normalized
end

function BuildOrderDiscovery_GetAge(kind, pathName, pbg)
	for age = 2, 4 do
		local ageType = "scar_age" .. age
		if (kind == "entity" or kind == "building") and Entity_IsEBPOfType(pbg, ageType) then
			return age
		elseif kind == "squad" and Squad_IsSBPOfType(pbg, ageType) then
			return age
		elseif (kind == "upgrade" or kind == "technology") and BP_IsUpgradeOfType(pbg, ageType) then
			return age
		end
	end
	return nil
end

function BuildOrderDiscovery_GetPresentation(kind, pathName, pbg, race)
	local uiInfo = nil
	if kind == "entity" or kind == "building" then
		uiInfo = BP_GetEntityUIInfo(pbg)
	elseif kind == "squad" then
		uiInfo = BP_GetSquadUIInfo(pbg, race)
	elseif kind == "upgrade" or kind == "technology" then
		uiInfo = BP_GetUpgradeUIInfo(pbg)
	end

	if uiInfo == nil then
		return nil, nil
	end

	local label = nil
	if uiInfo.screenName ~= nil then
		label = Loc_ToAnsi(uiInfo.screenName)
		if label == "" then
			label = nil
		end
	end

	local icon = uiInfo.iconName
	if icon == "" then
		icon = nil
	end
	return label, icon
end

function BuildOrderDiscovery_BelongsToRace(kind, pathName, race)
	if kind == "entity" or kind == "building" then
		local count = BP_GetEntityTypeExtRaceCount(pathName)
		for index = 0, count - 1 do
			if BP_GetEntityTypeExtRaceBlueprintAtIndex(pathName, index) == race then
				return true
			end
		end
	elseif kind == "squad" then
		local count = BP_GetSquadTypeExtRaceCount(pathName)
		for index = 0, count - 1 do
			if BP_GetSquadTypeExtRaceBlueprintAtIndex(pathName, index) == race then
				return true
			end
		end
	end
	return false
end

BUILD_ORDER_DISCOVERY_AGE_UP_UPGRADE_TYPES = {
	abbasid = "abbasid_wing_upgrade",
	ayyubids = "ayyubid_cmp_upgrade",
	templar = "age_up_upgrade",
	golden_horde = "age_up_upgrade",
}

function BuildOrderDiscovery_IsBuilding(pbg)
	return pbg ~= nil and Entity_IsEBPOfType(pbg, "building")
end

function BuildOrderDiscovery_IsAgeUpOption(kind, pbg, civ)
	if kind == "entity" then
		return Entity_IsEBPOfType(pbg, "landmark")
			and BuildOrderDiscovery_GetAge("entity", nil, pbg) ~= nil
	elseif kind == "upgrade" then
		local upgradeType = BUILD_ORDER_DISCOVERY_AGE_UP_UPGRADE_TYPES[civ]
		return upgradeType ~= nil and BP_IsUpgradeOfType(pbg, upgradeType)
			and BuildOrderDiscovery_GetAge("upgrade", nil, pbg) ~= nil
	end
	return false
end

-- SCAR exposes no read-only tech-tree membership query for an upgrade PBG.
-- This is a best-effort availability signal only: it is player-specific, but
-- must not be interpreted as a guaranteed civilization-membership predicate.
function BuildOrderDiscovery_IsTechnologyBestEffortAvailable(player, pbg)
	return pbg ~= nil and Player_GetUpgradeBPCost(player, pbg) ~= nil
end

function BuildOrderDiscovery_CreateOption(kind, pathName, pbg, race)
	local discoveredAge = BuildOrderDiscovery_GetAge(kind, pathName, pbg)
	local discoveredLabel, discoveredIcon = BuildOrderDiscovery_GetPresentation(kind, pathName, pbg, race)
	local age = discoveredAge or 1
	local label = discoveredLabel or pathName
	local icon = discoveredIcon or BUILD_ORDER_DISCOVERY_DEFAULT_ICONS[kind]
	return {
		id = pathName,
		ids = nil,
		kind = kind,
		age = age,
		label = label,
		icon = icon,
	}
end

function BuildOrderDiscovery_CollectFamilies(snapshot, player, race)
	local families = {}
	local archetypeNames = AI_CombatFitnessGetSquadArchetypeNames()
	for _, archetypeName in pairs(archetypeNames) do
		local members = {}
		local seen = {}
		local archetypePBGs = AI_CombatFitnessGetSquadArchetypePBGs(archetypeName)
		for _, pbg in pairs(archetypePBGs) do
			local pathName = BP_GetName(pbg)
			if seen[pathName] == nil and BuildOrderDiscovery_BelongsToRace("squad", pathName, race) then
				seen[pathName] = true
				local age = BuildOrderDiscovery_GetAge("squad", pathName, pbg) or 1
				local label, icon = BuildOrderDiscovery_GetPresentation("squad", pathName, pbg, race)
				table.insert(members, {
					id = pathName,
					age = age,
					label = label,
					icon = icon,
				})
			end
		end

		table.sort(members, function(left, right)
			if left.age ~= right.age then
				return left.age < right.age
			end
			return left.id < right.id
		end)

		if #members > 0 then
			local ids = {}
			for _, member in ipairs(members) do
				table.insert(ids, member.id)
			end
			local discoveredLabel = members[1].label
			local discoveredIcon = members[1].icon
			local pathName = ids[1]
			local label = discoveredLabel or pathName
			local icon = discoveredIcon or BUILD_ORDER_DISCOVERY_DEFAULT_ICONS.family
			table.insert(families, {
				id = nil,
				ids = ids,
				kind = "family",
				age = members[1].age,
				label = label,
				icon = icon,
			})
		end
	end
	return families
end

function BuildOrderDiscovery_GetSortID(option)
	if option.id ~= nil then
		return option.id
	end
	if option.ids ~= nil and option.ids[1] ~= nil then
		return option.ids[1]
	end
	return ""
end

function BuildOrderDiscovery_Sort(options)
	table.sort(options, function(left, right)
		local leftLabel = string.lower(left.label)
		local rightLabel = string.lower(right.label)
		if leftLabel ~= rightLabel then
			return leftLabel < rightLabel
		end
		return BuildOrderDiscovery_GetSortID(left) < BuildOrderDiscovery_GetSortID(right)
	end)
end

function BuildOrderDiscovery_Collect(player)
	local race = Player_GetRace(player)
	local raceName = Player_GetRaceName(player)
	local snapshot = {
		race = race,
		civ = BuildOrderDiscovery_CanonicalCivID(raceName),
		civ_name = raceName,
		buildings = {},
		entities = {},
		squads = {},
		technologies = {},
		upgrades = {},
		age_ups = {},
		families = {},
	}

	for index = 0, BP_GetPropertyBagGroupCount(PBG_EntityProperties) - 1 do
		local pathName = BP_GetPropertyBagGroupPathName(PBG_EntityProperties, index)
		if BuildOrderDiscovery_BelongsToRace("entity", pathName, race) then
			local pbg = BP_GetEntityBlueprint(pathName)
			if BuildOrderDiscovery_IsBuilding(pbg) then
				local buildingOption = BuildOrderDiscovery_CreateOption("building", pathName, pbg, race)
				table.insert(snapshot.buildings, buildingOption)
				if BuildOrderDiscovery_IsAgeUpOption("entity", pbg, snapshot.civ) then
					local ageUpOption = BuildOrderDiscovery_CreateOption("building", pathName, pbg, race)
					ageUpOption.kind = "age_up"
					table.insert(snapshot.age_ups, ageUpOption)
				end
			end
		end
	end

	for index = 0, BP_GetPropertyBagGroupCount(PBG_SquadProperties) - 1 do
		local pathName = BP_GetPropertyBagGroupPathName(PBG_SquadProperties, index)
		if BuildOrderDiscovery_BelongsToRace("squad", pathName, race) then
			local pbg = BP_GetSquadBlueprint(pathName)
			table.insert(snapshot.squads, BuildOrderDiscovery_CreateOption("squad", pathName, pbg, race))
		end
	end

	for index = 0, BP_GetPropertyBagGroupCount(PBG_UpgradeProperties) - 1 do
		local pathName = BP_GetPropertyBagGroupPathName(PBG_UpgradeProperties, index)
		local pbg = BP_GetUpgradeBlueprint(pathName)
		if BuildOrderDiscovery_IsTechnologyBestEffortAvailable(player, pbg) then
			local option = BuildOrderDiscovery_CreateOption("technology", pathName, pbg, race)
			if BuildOrderDiscovery_IsAgeUpOption("upgrade", pbg, snapshot.civ) then
				option.kind = "age_up"
				table.insert(snapshot.age_ups, option)
			else
				table.insert(snapshot.technologies, option)
			end
		end
	end

	snapshot.families = BuildOrderDiscovery_CollectFamilies(snapshot, player, race)
	snapshot.entities = snapshot.buildings
	snapshot.upgrades = snapshot.technologies
	BuildOrderDiscovery_Sort(snapshot.buildings)
	BuildOrderDiscovery_Sort(snapshot.squads)
	BuildOrderDiscovery_Sort(snapshot.technologies)
	BuildOrderDiscovery_Sort(snapshot.age_ups)
	BuildOrderDiscovery_Sort(snapshot.families)
	BUILD_ORDER_DISCOVERY_CURRENT = snapshot
	return snapshot
end

function BuildOrderDiscovery_Filter(snapshot, kind, maximumAge)
	local filtered = {}
	local listName = BUILD_ORDER_DISCOVERY_LISTS[kind]
	if snapshot == nil or listName == nil then
		return filtered
	end
	local options = snapshot[listName] or {}
	for _, option in ipairs(options) do
		if option.age <= maximumAge then
			table.insert(filtered, option)
		end
	end
	return filtered
end

function BuildOrderDiscovery_FilterExactAge(snapshot, kind, expectedAge)
	local filtered = {}
	local listName = BUILD_ORDER_DISCOVERY_LISTS[kind]
	if snapshot == nil or listName == nil then
		return filtered
	end
	for _, option in ipairs(snapshot[listName] or {}) do
		if option.age == expectedAge then
			table.insert(filtered, option)
		end
	end
	return filtered
end

function BuildOrderDiscovery_Clear()
	BUILD_ORDER_DISCOVERY_CURRENT = nil
end
