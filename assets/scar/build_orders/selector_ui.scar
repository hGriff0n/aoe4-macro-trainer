BUILD_ORDER_SELECTOR_UI_NAME = "BuildOrderSelectorUI"

BUILD_ORDER_SELECTOR_UI_XAML = [[
<Grid x:Name="BuildOrderSelectorRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="545"
      Height="300"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="#F21B2638">
	<Grid.Resources>
		<DataTemplate x:Key="BuildOrderCardTemplate">
			<TextBlock Foreground="#FFF4F1E8" FontSize="16" Text="{Binding [label]}" />
		</DataTemplate>
	</Grid.Resources>
	<Border x:Name="BuildOrderSelectorFrame"
	        Background="#F21B2638"
	        BorderBrush="#FFC39A5A"
	        BorderThickness="2">
		<Border x:Name="BuildOrderSelectorInnerFrame"
		        BorderBrush="#FF5E4A2A"
		        BorderThickness="1">
			<Grid x:Name="BuildOrderSelectorPane" Margin="28">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock x:Name="BuildOrderSelectorTitle"
				           Grid.Row="0"
				           Margin="0,0,0,24"
				           FontSize="24"
				           FontWeight="Bold"
				           Foreground="#FFF2E2B6"
				           Text="Choose a Build Order" />
				<Grid Grid.Row="1">
					<ListBox x:Name="BuildOrderSelectorList"
					         Background="Transparent"
					         Foreground="#FFF4F1E8"
					         BorderThickness="0"
					         OverridesDefaultStyle="True"
					         ItemTemplate="{StaticResource BuildOrderCardTemplate}"
					         ItemsSource="{Binding [selector_options]}"
					         SelectedIndex="{Binding [selected_index], Mode=OneWay}"
					         ScrollViewer.VerticalScrollBarVisibility="Auto">
						<ListBox.Template>
							<ControlTemplate TargetType="{x:Type ListBox}">
								<Border x:Name="BuildOrderListChrome" Background="Transparent" BorderThickness="0">
									<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
								</Border>
							</ControlTemplate>
						</ListBox.Template>
						<ListBox.ItemContainerStyle>
							<Style TargetType="{x:Type ListBoxItem}">
								<Setter Property="OverridesDefaultStyle" Value="True" />
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type ListBoxItem}">
											<Border x:Name="BuildOrderCardChrome"
											        Margin="0,0,0,4"
											        Padding="12,10"
											        Background="#FF182235"
											        BorderBrush="#FF5E4A2A"
											        BorderThickness="1">
												<ContentPresenter Content="{TemplateBinding Content}"
												                  ContentTemplate="{TemplateBinding ContentTemplate}" />
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="BuildOrderCardChrome" Property="BorderBrush" Value="#FFC39A5A" />
												</Trigger>
												<Trigger Property="IsSelected" Value="True">
													<Setter TargetName="BuildOrderCardChrome" Property="Background" Value="#FF176B8A" />
													<Setter TargetName="BuildOrderCardChrome" Property="BorderBrush" Value="#FFF0D08A" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ListBox.ItemContainerStyle>
					</ListBox>
					<TextBlock x:Name="BuildOrderSelectorEmptyMessage"
					           Foreground="#FFF4F1E8"
					           IsHitTestVisible="False"
					           Text="{Binding [empty_message]}"
					           TextWrapping="Wrap" />
				</Grid>
				<StackPanel Grid.Row="2" Orientation="Horizontal">
					<Button x:Name="BuildOrderSelectorStartGame"
					        MinWidth="110"
					        Padding="12,7"
					        HorizontalAlignment="Left"
					        Background="#FFD7A84A"
					        Foreground="#FF172033"
					        BorderBrush="#FFF0D08A"
					        BorderThickness="1"
					        FontWeight="Bold"
					        OverridesDefaultStyle="True"
					        Command="{Binding [commands][start_game]}"
					        CommandParameter="{Binding SelectedItem[id], ElementName=BuildOrderSelectorList}"
					        Content="Start Game">
						<Button.Template>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border x:Name="BuildOrderStartGameChrome"
								        Padding="{TemplateBinding Padding}"
								        Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter Content="{TemplateBinding Content}"
									                  HorizontalAlignment="Center"
									                  VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<Button x:Name="BuildOrderSelectorContinueWithout"
					        MinWidth="180"
					        Margin="12,0,0,0"
					        Padding="12,7"
					        Background="#FF182235"
					        Foreground="#FFF2E2B6"
					        BorderBrush="#FFC39A5A"
					        BorderThickness="1"
					        FontWeight="Bold"
					        OverridesDefaultStyle="True"
					        Command="{Binding [commands][continue_without]}"
					        Content="Continue Without Build Order">
						<Button.Template>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border Padding="{TemplateBinding Padding}"
								        Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter Content="{TemplateBinding Content}"
									                  HorizontalAlignment="Center"
									                  VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Border>
</Grid>
]]

BUILD_ORDER_SELECTOR_UI_STATE = {
	created = false,
	model = {},
	view_model = nil,
	callbacks = {},
	commands = nil,
}

function BuildOrderSelectorUI_InvokeCallback(key, parameter)
	local callbackName = BUILD_ORDER_SELECTOR_UI_STATE.callbacks[key]
	if type(callbackName) ~= "string" or type(_G[callbackName]) ~= "function" then
		return false
	end
	_G[callbackName](parameter)
	return true
end

function BuildOrderSelectorUI_DispatchStartGame(parameter)
	return BuildOrderSelectorUI_InvokeCallback("start_game", parameter)
end

function BuildOrderSelectorUI_DispatchContinueWithout(parameter)
	return BuildOrderSelectorUI_InvokeCallback("continue_without", parameter)
end

function BuildOrderSelectorUI_Options(model)
	local options = {}
	for _, order in ipairs(model.orders or {}) do
		if type(order) == "table" then
			table.insert(options, {
				id = order.id or "",
				label = order.label or order.title or order.id or "",
				selected = order.selected == true,
			})
		end
	end
	return options
end

function BuildOrderSelectorUI_BuildViewModel(model)
	model = type(model) == "table" and model or {}
	local options = BuildOrderSelectorUI_Options(model)
	return {
		selector_options = options,
		selected_index = -1,
		empty_message = #options == 0 and "No build orders for this civilization" or "",
		commands = BUILD_ORDER_SELECTOR_UI_STATE.commands or {},
	}
end

function BuildOrderSelectorUI_CreatePresenter()
	BUILD_ORDER_SELECTOR_UI_STATE.commands = {
		start_game = UI_CreateCommand("BuildOrderSelectorUI_DispatchStartGame"),
		continue_without = UI_CreateCommand("BuildOrderSelectorUI_DispatchContinueWithout"),
	}
	BUILD_ORDER_SELECTOR_UI_STATE.view_model = BuildOrderSelectorUI_BuildViewModel(
		BUILD_ORDER_SELECTOR_UI_STATE.model
	)
	UI_AddChild("ScarDefault", "XamlPresenter", BUILD_ORDER_SELECTOR_UI_NAME, {
		IsHitTestVisible = true,
		Xaml = BUILD_ORDER_SELECTOR_UI_XAML,
		DataContext = UI_CreateDataContext(BUILD_ORDER_SELECTOR_UI_STATE.view_model),
	})
end

function BuildOrderSelectorUI_EnsureCreated()
	if BUILD_ORDER_SELECTOR_UI_STATE.created then
		return true
	end
	local success = pcall(BuildOrderSelectorUI_CreatePresenter)
	if not success then
		BUILD_ORDER_SELECTOR_UI_STATE.view_model = nil
		return false
	end
	BUILD_ORDER_SELECTOR_UI_STATE.created = true
	return true
end

function BuildOrderSelectorUI_Show(model)
	BUILD_ORDER_SELECTOR_UI_STATE.model = type(model) == "table" and model or {}
	if not BuildOrderSelectorUI_EnsureCreated() then
		return false
	end
	BUILD_ORDER_SELECTOR_UI_STATE.view_model = BuildOrderSelectorUI_BuildViewModel(
		BUILD_ORDER_SELECTOR_UI_STATE.model
	)
	UI_SetDataContext(BUILD_ORDER_SELECTOR_UI_NAME, BUILD_ORDER_SELECTOR_UI_STATE.view_model)
	return true
end

function BuildOrderSelectorUI_Hide()
	if BUILD_ORDER_SELECTOR_UI_STATE.created then
		UI_Remove(BUILD_ORDER_SELECTOR_UI_NAME)
	end
	BUILD_ORDER_SELECTOR_UI_STATE.created = false
	BUILD_ORDER_SELECTOR_UI_STATE.model = {}
	BUILD_ORDER_SELECTOR_UI_STATE.view_model = nil
	BUILD_ORDER_SELECTOR_UI_STATE.commands = nil
	return true
end

function BuildOrderSelectorUI_SetCallbacks(callbacks)
	BUILD_ORDER_SELECTOR_UI_STATE.callbacks = type(callbacks) == "table" and callbacks or {}
end

function BuildOrderSelectorUI_Stop()
	BuildOrderSelectorUI_Hide()
	BUILD_ORDER_SELECTOR_UI_STATE.callbacks = {}
end
