-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_selector_data = {
    created_ui = false,
    model = nil,
    view = nil,
    commands = nil,
    callbacks = {}
}

BUILD_ORDER_SELECTOR_UI_NAME = "BuildOrderSelectorUI"
EMPTY_BO_LIST_MESSAGE = "No build orders for this civilization"

BO_UI_XAML = [[
<Grid x:Name="BuildOrderSelectorRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="545"
      Height="300"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="#F21B2638">
	<Grid.Resources>
		<DataTemplate x:Key="BuildOrderCardTemplate">
			<TextBlock Foreground="#FFF4F1E8" FontSize="16" Text="{Binding [label]}" />
		</DataTemplate>
	</Grid.Resources>
	<Border x:Name="BuildOrderSelectorFrame"
	        Background="#F21B2638"
	        BorderBrush="#FFC39A5A"
	        BorderThickness="2">
		<Border x:Name="BuildOrderSelectorInnerFrame"
		        BorderBrush="#FF5E4A2A"
		        BorderThickness="1">
			<Grid x:Name="BuildOrderSelectorPane" Margin="28">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock x:Name="BuildOrderSelectorTitle"
				           Grid.Row="0"
				           Margin="0,0,0,24"
				           FontSize="24"
				           FontWeight="Bold"
				           Foreground="#FFF2E2B6"
				           Text="Choose a Build Order" />
				<Grid Grid.Row="1">
					<ListBox x:Name="BuildOrderSelectorList"
					         Background="Transparent"
					         Foreground="#FFF4F1E8"
					         BorderThickness="0"
					         OverridesDefaultStyle="True"
					         ItemTemplate="{StaticResource BuildOrderCardTemplate}"
					         ItemsSource="{Binding [selector_options]}"
					         SelectedIndex="{Binding [selected_index], Mode=OneWay}"
					         ScrollViewer.VerticalScrollBarVisibility="Auto">
						<ListBox.Template>
							<ControlTemplate TargetType="{x:Type ListBox}">
								<Border x:Name="BuildOrderListChrome" Background="Transparent" BorderThickness="0">
									<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
								</Border>
							</ControlTemplate>
						</ListBox.Template>
						<ListBox.ItemContainerStyle>
							<Style TargetType="{x:Type ListBoxItem}">
								<Setter Property="OverridesDefaultStyle" Value="True" />
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type ListBoxItem}">
											<Border x:Name="BuildOrderCardChrome"
											        Margin="0,0,0,4"
											        Padding="12,10"
											        Background="#FF182235"
											        BorderBrush="#FF5E4A2A"
											        BorderThickness="1">
												<ContentPresenter Content="{TemplateBinding Content}"
												                  ContentTemplate="{TemplateBinding ContentTemplate}" />
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="BuildOrderCardChrome" Property="BorderBrush" Value="#FFC39A5A" />
												</Trigger>
												<Trigger Property="IsSelected" Value="True">
													<Setter TargetName="BuildOrderCardChrome" Property="Background" Value="#FF176B8A" />
													<Setter TargetName="BuildOrderCardChrome" Property="BorderBrush" Value="#FFF0D08A" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ListBox.ItemContainerStyle>
					</ListBox>
					<TextBlock x:Name="BuildOrderSelectorEmptyMessage"
					           Foreground="#FFF4F1E8"
					           IsHitTestVisible="False"
					           Text="{Binding [empty_message]}"
					           TextWrapping="Wrap" />
				</Grid>
				<StackPanel Grid.Row="2" Orientation="Horizontal">
					<Button x:Name="BuildOrderSelectorStartGame"
					        MinWidth="110"
					        Padding="12,7"
					        HorizontalAlignment="Left"
					        Background="#FFD7A84A"
					        Foreground="#FF172033"
					        BorderBrush="#FFF0D08A"
					        BorderThickness="1"
					        FontWeight="Bold"
					        OverridesDefaultStyle="True"
					        Command="{Binding [commands][start_game]}"
					        CommandParameter="{Binding SelectedItem[id], ElementName=BuildOrderSelectorList}"
					        Content="Start Game">
						<Button.Template>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border x:Name="BuildOrderStartGameChrome"
								        Padding="{TemplateBinding Padding}"
								        Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter Content="{TemplateBinding Content}"
									                  HorizontalAlignment="Center"
									                  VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<Button x:Name="BuildOrderSelectorContinueWithout"
					        MinWidth="180"
					        Margin="12,0,0,0"
					        Padding="12,7"
					        Background="#FF182235"
					        Foreground="#FFF2E2B6"
					        BorderBrush="#FFC39A5A"
					        BorderThickness="1"
					        FontWeight="Bold"
					        OverridesDefaultStyle="True"
					        Command="{Binding [commands][continue_without]}"
					        Content="Continue Without Build Order">
						<Button.Template>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border Padding="{TemplateBinding Padding}"
								        Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter Content="{TemplateBinding Content}"
									                  HorizontalAlignment="Center"
									                  VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Border>
</Grid>
]]

-----------------------------------------------------------------------
-- Helper Functions
-----------------------------------------------------------------------

local function BuildOrderSelectorUI_InvokeCallback(key, parameter)
	local callbackName = BUILD_ORDER_SELECTOR_UI_STATE.callbacks[key]
	if type(callbackName) ~= "string" or
       type(_G[callbackName]) ~= "function"
    then
		return false
	end
	_G[callbackName](parameter)
	return true
end

local function BuildOrderSelectorUI_DispatchStartGame(parameter)
	return BuildOrderSelectorUI_InvokeCallback("start_game", parameter)
end

local function BuildOrderSelectorUI_DispatchContinueWithout(parameter)
	return BuildOrderSelectorUI_InvokeCallback("continue_without", parameter)
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOderSelectorUI_Show(model)
    if not type(model) == "table" then
        return false
    end

    _selector_data.model = model
	if not BuildOrderSelectorUI_EnsureCreated() then
		return false
	end

    UI_SetDataContext(BUILD_ORDER_SELECTOR_UI_NAME, _selector_data.view)
    return true
end

function BuildOderSelectorUI_Hide()
    if _selector_data.created_ui then
        UI_Remove(BUILD_ORDER_SELECTOR_UI_NAME)
    end

    _selector_data.created_ui = false
    _selector_data.model = nil
    _selector_data.view = nil
    _selector_data.commands = nil
    return true
end

function BuildOrderSelectorUI_SetCallbacks(callbacks)
    if type(callbacks) == "table" and callbacks then
        _selector_data.callbacks = callbacks
    end
end

function BuildOrderSelectorUI_Stop()
	BuildOrderSelectorUI_Hide()
	_selector_data.callbacks = {}
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------

local function BuildOrderSelectorUI_CreatePresenter()
    _selector_data.commands = {
        start_game = UI_CreateCommand("BuildOrderSelectorUI_DispatchStartGame"),
        continue_without = UI_CreateCommand("BuildOrderSelectorUI_DispatchContinueWithout"),
    }

    _selector_data.view = {
        selector_options = _selector_data.model.orders,
        selected_index = -1,
        empty_message = #_selector_data.model.orders == 0
            and EMPTY_BO_LIST_MESSAGE or "",
        commands = _selector_data.commands
    }
	UI_AddChild(
        "ScarDefault", "XamlPresenter", BUILD_ORDER_SELECTOR_UI_NAME,
        {
            IsHitTestVisible = true,
            Xaml = BUILD_ORDER_SELECTOR_UI_XAML,
		    DataContext = UI_CreateDataContext(_selector_data.view),
	    })
end

function BuildOrderSelectorUI_EnsureCreated()
    if _selector_data.created_ui then
        return true
    end

    local success = pcall(BuildOrderSelectorUI_CreatePresenter)
    if not success then
        BuildOderSelectorUI_Hide()
        return false
    end

    _selector_data.created_ui = true
    return true
end
