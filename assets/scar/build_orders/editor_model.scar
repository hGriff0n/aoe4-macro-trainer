BUILD_ORDER_EDITOR_RESOURCES = { "food", "wood", "gold", "stone" }
BUILD_ORDER_EDITOR_MAX_AGE = 4
BUILD_ORDER_EDITOR_CHECK_KINDS = {
	vils = true,
	rallypoint = true,
	built = true,
	age_up = true,
	upgrades = true,
	produce = true,
	resources = true,
	buildings = true,
	units = true,
	hints = true,
}
BUILD_ORDER_EDITOR_DISCOVERY_LISTS = {
	entity = "entities",
	squad = "squads",
	upgrade = "upgrades",
	family = "families",
}
BUILD_ORDER_EDITOR_UPGRADE_AGE_UP_CIVS = {
	abbasid = true,
	ayyubids = true,
	templar = true,
	golden_horde = true,
}

function BuildOrderEditor_DeepCopy(value, seen)
	if type(value) ~= "table" then
		return value
	end
	seen = seen or {}
	if seen[value] ~= nil then
		return seen[value]
	end

	local copy = {}
	seen[value] = copy
	for key, item in pairs(value) do
		copy[BuildOrderEditor_DeepCopy(key, seen)] = BuildOrderEditor_DeepCopy(item, seen)
	end
	return copy
end

function BuildOrderEditor_Trim(value)
	if type(value) ~= "string" then
		return ""
	end
	local trimmed = string.gsub(value, "^%s+", "")
	trimmed = string.gsub(trimmed, "%s+$", "")
	return trimmed
end

function BuildOrderEditor_NormalizeID(value)
	local normalized = string.lower(value or "")
	normalized = string.gsub(normalized, "[^a-z0-9]+", "-")
	normalized = string.gsub(normalized, "^-+", "")
	normalized = string.gsub(normalized, "-+$", "")
	return normalized
end

function BuildOrderEditor_MakeID(civ, title)
	return BuildOrderEditor_NormalizeID(civ .. "-" .. title)
end

function BuildOrderEditor_HumanizeID(identifier)
	if type(identifier) ~= "string" then
		return ""
	end
	local label = string.gsub(identifier, "[/_]+", " ")
	label = string.gsub(label, "%s+", " ")
	return BuildOrderEditor_Trim(label)
end

function BuildOrderEditor_GetSelectionLabel(selection)
	if type(selection) == "string" then
		return BuildOrderEditor_HumanizeID(selection)
	end
	if type(selection) ~= "table" then
		return ""
	end
	if type(selection.label) == "string" and selection.label ~= "" then
		return selection.label
	end
	if type(selection.id) == "string" then
		return BuildOrderEditor_HumanizeID(selection.id)
	end
	if type(selection.ids) == "table" and type(selection.ids[1]) == "string" then
		return BuildOrderEditor_HumanizeID(selection.ids[1])
	end
	return ""
end

function BuildOrderEditor_GetFamilyIDs(family)
	if type(family) ~= "table" then
		return {}
	end
	if type(family.ids) == "table" then
		return BuildOrderEditor_DeepCopy(family.ids)
	end
	return BuildOrderEditor_DeepCopy(family)
end

function BuildOrderEditor_GetAlternativeIDs(payload)
	if type(payload) ~= "table" then
		return {}
	end
	if type(payload.id) == "string" then
		return { payload.id }
	end
	if type(payload.oneof) == "table" then
		return BuildOrderEditor_DeepCopy(payload.oneof)
	end
	return {}
end

function BuildOrderEditor_SetAlternatives(field, ids)
	field = field or {}
	ids = ids or {}
	field.id = nil
	field.oneof = nil
	if #ids == 1 then
		field.id = ids[1]
	elseif #ids > 1 then
		field.oneof = {}
		for _, id in ipairs(ids) do
			table.insert(field.oneof, id)
		end
	end
	return field
end

function BuildOrderEditor_Move(list, fromIndex, toIndex)
	if type(list) ~= "table" then
		return false
	end
	if type(fromIndex) ~= "number" or fromIndex ~= math.floor(fromIndex)
		or fromIndex < 1 or fromIndex > #list then
		return false
	end
	if type(toIndex) ~= "number" or toIndex ~= math.floor(toIndex)
		or toIndex < 1 or toIndex > #list then
		return false
	end
	if fromIndex == toIndex then
		return true
	end
	local item = table.remove(list, fromIndex)
	table.insert(list, toIndex, item)
	if type(list._draft) == "table" then
		BuildOrderEditor_InferAges(list._draft)
	end
	return true
end

function BuildOrderEditor_InferAges(draft)
	local age = 1
	if type(draft) ~= "table" or type(draft.steps) ~= "table" then
		return draft
	end
	draft.steps._draft = draft
	for _, step in ipairs(draft.steps) do
		if type(step) == "table" then
			step.inferred_age = age
			if type(step.checks) == "table" then
				step.checks._draft = draft
				for _, check in ipairs(step.checks) do
					if type(check) == "table" then
						if check.kind == "age_up" then
							age = age + 1
							if age > BUILD_ORDER_EDITOR_MAX_AGE then
								age = BUILD_ORDER_EDITOR_MAX_AGE
							end
							break
						end
					end
				end
			end
		end
	end
	return draft
end

function BuildOrderEditor_NewDraft(civ)
	local draft = {
		original_id = nil,
		civ = civ or "",
		title = "",
		steps = {},
	}
	BuildOrderEditor_InferAges(draft)
	return draft
end

function BuildOrderEditor_FromRuntimeCheck(runtimeCheck)
	local payload = BuildOrderEditor_DeepCopy(runtimeCheck.payload or {})
	if runtimeCheck.kind == "built" or runtimeCheck.kind == "age_up" then
		payload.alternatives = BuildOrderEditor_GetAlternativeIDs(payload)
		payload.id = nil
		payload.oneof = nil
	elseif runtimeCheck.kind == "produce" or runtimeCheck.kind == "units" then
		payload.family = { ids = BuildOrderEditor_DeepCopy(payload.ids or {}) }
		payload.ids = nil
	end

	if runtimeCheck.kind == "built" or runtimeCheck.kind == "buildings"
		or runtimeCheck.kind == "produce" or runtimeCheck.kind == "units" then
		payload.count = payload.count or 1
	end
	if runtimeCheck.kind == "upgrades" then
		payload.queued = payload.queued == true
	elseif runtimeCheck.kind == "produce" then
		payload.constant = payload.constant == true
		payload.queued = payload.queued == true
	end

	local optional = runtimeCheck.optional == true
	if runtimeCheck.kind == "hints" then
		optional = true
	end
	return {
		kind = runtimeCheck.kind,
		optional = optional,
		payload = payload,
	}
end

function BuildOrderEditor_MergeRuntimeVils(draftCheck, runtimeCheck)
	local payload = runtimeCheck.payload or {}
	if payload.no_collect == true and type(payload.resource) == "string" then
		table.insert(draftCheck.payload.no_collect, payload.resource)
	elseif type(payload.resource) == "string" and payload.count ~= nil then
		draftCheck.payload[payload.resource] = payload.count
	else
		for _, resource in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
			if payload[resource] ~= nil then
				draftCheck.payload[resource] = payload[resource]
			end
		end
	end
end

function BuildOrderEditor_MergeRuntimeResources(draftCheck, runtimeCheck)
	local payload = runtimeCheck.payload or {}
	if type(payload.resource) == "string" and payload.count ~= nil then
		draftCheck.payload[payload.resource] = payload.count
	end
end

function BuildOrderEditor_FromRuntimeSteps(runtimeSteps)
	local steps = {}
	for _, runtimeStep in ipairs(runtimeSteps or {}) do
		local draftStep = {
			title = runtimeStep.title or "",
			checks = {},
		}
		local activeVils = nil
		local activeResources = nil
		for _, runtimeCheck in ipairs(runtimeStep.checks or {}) do
			if runtimeCheck.kind == "vils" then
				activeResources = nil
				if activeVils == nil then
					activeVils = {
						kind = "vils",
						optional = runtimeCheck.optional == true,
						payload = { no_collect = {} },
					}
					table.insert(draftStep.checks, activeVils)
				end
				BuildOrderEditor_MergeRuntimeVils(activeVils, runtimeCheck)
			elseif runtimeCheck.kind == "resources" then
				activeVils = nil
				if activeResources == nil then
					activeResources = {
						kind = "resources",
						optional = runtimeCheck.optional == true,
						payload = {},
					}
					table.insert(draftStep.checks, activeResources)
				end
				BuildOrderEditor_MergeRuntimeResources(activeResources, runtimeCheck)
			else
				activeVils = nil
				activeResources = nil
				table.insert(draftStep.checks, BuildOrderEditor_FromRuntimeCheck(runtimeCheck))
			end
		end
		table.insert(steps, draftStep)
	end
	return steps
end

function BuildOrderEditor_EditDraft(order)
	if type(order) ~= "table" then
		return BuildOrderEditor_NewDraft("")
	end
	local draft = BuildOrderEditor_DeepCopy(order)
	draft.original_id = order.id
	draft.original_civ = order.civ
	draft.original_title = order.title
	draft.id = nil
	draft.steps = BuildOrderEditor_FromRuntimeSteps(draft.steps)
	BuildOrderEditor_InferAges(draft)
	return draft
end

function BuildOrderEditor_CopyDraft(order, catalog)
	local draft = BuildOrderEditor_EditDraft(order)
	draft.original_id = nil
	draft.original_civ = nil
	draft.original_title = nil
	local baseTitle = draft.title
	local copyNumber = 1
	while true do
		local suffix = " (copy)"
		if copyNumber > 1 then
			suffix = " (copy " .. copyNumber .. ")"
		end
		local candidate = baseTitle .. suffix
		local candidateID = BuildOrderEditor_MakeID(draft.civ, candidate)
		if catalog == nil or catalog[candidateID] == nil then
			draft.title = candidate
			break
		end
		copyNumber = copyNumber + 1
	end
	BuildOrderEditor_InferAges(draft)
	return draft
end

function BuildOrderEditor_AddError(errors, path, message)
	table.insert(errors, {
		path = path,
		message = message,
	})
end

function BuildOrderEditor_ValidateOptionalPositiveInteger(errors, path, value)
	if value == nil then
		return true
	end
	if type(value) ~= "number" or value <= 0 or value ~= math.floor(value) then
		BuildOrderEditor_AddError(errors, path, "must be a positive integer or unselected")
		return false
	end
	return true
end

function BuildOrderEditor_ValidateRequiredPositiveInteger(errors, path, value)
	if value == nil then
		BuildOrderEditor_AddError(errors, path, "must be selected")
		return false
	end
	return BuildOrderEditor_ValidateOptionalPositiveInteger(errors, path, value)
end

function BuildOrderEditor_ValidateResourceFields(errors, path, payload)
	local selected = 0
	for _, resource in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
		local value = payload[resource]
		if value ~= nil then
			selected = selected + 1
		end
		BuildOrderEditor_ValidateOptionalPositiveInteger(errors, path .. "." .. resource, value)
	end
	return selected
end

function BuildOrderEditor_IsResource(resource)
	for _, candidate in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
		if resource == candidate then
			return true
		end
	end
	return false
end

function BuildOrderEditor_DiscoveryHasID(discovery, kind, id)
	if type(discovery) ~= "table" then
		return false
	end
	local listName = BUILD_ORDER_EDITOR_DISCOVERY_LISTS[kind]
	for _, option in ipairs(discovery[listName] or {}) do
		if option.id == id then
			return true
		end
	end
	return false
end

function BuildOrderEditor_DiscoveryHasAnyScalarID(discovery, id)
	return BuildOrderEditor_DiscoveryHasID(discovery, "entity", id)
		or BuildOrderEditor_DiscoveryHasID(discovery, "squad", id)
		or BuildOrderEditor_DiscoveryHasID(discovery, "upgrade", id)
end

function BuildOrderEditor_ValidateLiveID(errors, path, id, discovery, expectedKinds)
	if type(id) ~= "string" or id == "" then
		BuildOrderEditor_AddError(errors, path, "must select a game-data value")
		return false
	end
	if discovery == nil then
		return true
	end
	for _, expectedKind in ipairs(expectedKinds) do
		if BuildOrderEditor_DiscoveryHasID(discovery, expectedKind, id) then
			return true
		end
	end
	if BuildOrderEditor_DiscoveryHasAnyScalarID(discovery, id) then
		BuildOrderEditor_AddError(errors, path, "does not match the required game-data kind")
		return false
	end
	-- Unknown saved identifiers remain valid so an edited order can preserve a fallback value.
	return true
end

function BuildOrderEditor_ListsEqual(left, right)
	if type(left) ~= "table" or type(right) ~= "table" or #left ~= #right then
		return false
	end
	for index, value in ipairs(left) do
		if right[index] ~= value then
			return false
		end
	end
	return true
end

function BuildOrderEditor_DiscoveryHasFamily(discovery, ids)
	if type(discovery) ~= "table" then
		return false
	end
	for _, option in ipairs(discovery.families or {}) do
		if BuildOrderEditor_ListsEqual(option.ids, ids) then
			return true
		end
	end
	return false
end

function BuildOrderEditor_ValidateFamily(errors, path, family, discovery)
	local ids = BuildOrderEditor_GetFamilyIDs(family)
	if #ids == 0 then
		BuildOrderEditor_AddError(errors, path, "must select a unit family")
		return false
	end
	local seen = {}
	for index, id in ipairs(ids) do
		if type(id) ~= "string" or id == "" then
			BuildOrderEditor_AddError(errors, path .. ".ids." .. index, "must be a canonical squad identifier")
			return false
		end
		if seen[id] == true then
			BuildOrderEditor_AddError(errors, path .. ".ids." .. index, "must not repeat a canonical squad identifier")
			return false
		end
		seen[id] = true
	end
	if discovery ~= nil and not BuildOrderEditor_DiscoveryHasFamily(discovery, ids) then
		local discoveredMember = false
		for _, id in ipairs(ids) do
			if BuildOrderEditor_DiscoveryHasID(discovery, "squad", id) then
				discoveredMember = true
			end
		end
		if discoveredMember then
			BuildOrderEditor_AddError(errors, path, "does not match a discovered semantic unit family")
			return false
		end
	end
	return true
end

function BuildOrderEditor_ValidateAlternatives(errors, path, ids, discovery, expectedKinds)
	if type(ids) ~= "table" or #ids == 0 then
		BuildOrderEditor_AddError(errors, path, "must contain at least one selection")
		return false
	end
	local valid = true
	local seen = {}
	for index, id in ipairs(ids) do
		local itemPath = path .. "." .. index
		if type(id) ~= "string" or id == "" then
			BuildOrderEditor_ValidateLiveID(errors, itemPath, id, discovery, expectedKinds)
			valid = false
		elseif seen[id] == true then
			BuildOrderEditor_AddError(errors, itemPath, "must not repeat a selection")
			valid = false
		else
			seen[id] = true
			if not BuildOrderEditor_ValidateLiveID(errors, itemPath, id, discovery, expectedKinds) then
				valid = false
			end
		end
	end
	return valid
end

function BuildOrderEditor_GetAgeUpDiscoveryKind(civ)
	if type(civ) ~= "string" then
		return "entity"
	end
	local normalizedCiv = string.lower(civ or "")
	if BUILD_ORDER_EDITOR_UPGRADE_AGE_UP_CIVS[normalizedCiv] == true then
		return "upgrade"
	end
	return "entity"
end

function BuildOrderEditor_ValidateNoCollect(errors, path, values)
	if type(values) ~= "table" then
		BuildOrderEditor_AddError(errors, path, "must be a resource list")
		return false
	end
	local valid = true
	local seen = {}
	for index, resource in ipairs(values) do
		if not BuildOrderEditor_IsResource(resource) then
			BuildOrderEditor_AddError(errors, path .. "." .. index, "must be food, wood, gold, or stone")
			valid = false
		elseif seen[resource] == true then
			BuildOrderEditor_AddError(errors, path .. "." .. index, "must not repeat a resource")
			valid = false
		else
			seen[resource] = true
		end
	end
	return valid
end

function BuildOrderEditor_ValidateBoolean(errors, path, value)
	if type(value) ~= "boolean" then
		BuildOrderEditor_AddError(errors, path, "must be true or false")
		return false
	end
	return true
end

function BuildOrderEditor_ValidateOptionalString(errors, path, value)
	if value ~= nil and (type(value) ~= "string" or BuildOrderEditor_Trim(value) == "") then
		BuildOrderEditor_AddError(errors, path, "must be a non-empty string or unselected")
		return false
	end
	return true
end

function BuildOrderEditor_ValidateCheck(errors, path, check, discovery, civ)
	if type(check) ~= "table" then
		BuildOrderEditor_AddError(errors, path, "must be a check")
		return
	end
	if type(check.kind) ~= "string" or BUILD_ORDER_EDITOR_CHECK_KINDS[check.kind] ~= true then
		BuildOrderEditor_AddError(errors, path .. ".kind", "must be a supported check kind")
		return
	end
	if type(check.optional) ~= "boolean" then
		BuildOrderEditor_AddError(errors, path .. ".optional", "must be true or false")
	end
	if type(check.payload) ~= "table" then
		BuildOrderEditor_AddError(errors, path .. ".payload", "must be an object")
		return
	end

	local payload = check.payload
	if check.kind == "vils" then
		local selected = BuildOrderEditor_ValidateResourceFields(errors, path .. ".payload", payload)
		local noCollect = payload.no_collect
		if noCollect == nil then
			noCollect = {}
		end
		BuildOrderEditor_ValidateNoCollect(errors, path .. ".payload.no_collect", noCollect)
		local noCollectCount = 0
		if type(noCollect) == "table" then
			noCollectCount = #noCollect
		end
		if selected == 0 and noCollectCount == 0 then
			BuildOrderEditor_AddError(errors, path .. ".payload", "must select a threshold or no-collect resource")
		end
	elseif check.kind == "resources" then
		local selected = BuildOrderEditor_ValidateResourceFields(errors, path .. ".payload", payload)
		if selected == 0 then
			BuildOrderEditor_AddError(errors, path .. ".payload", "must select at least one resource")
		end
	elseif check.kind == "rallypoint" then
		if not BuildOrderEditor_IsResource(payload.resource) then
			BuildOrderEditor_AddError(errors, path .. ".payload.resource", "must be food, wood, gold, or stone")
		end
	elseif check.kind == "built" then
		BuildOrderEditor_ValidateAlternatives(errors, path .. ".payload.alternatives", payload.alternatives, discovery, { "entity" })
		BuildOrderEditor_ValidateRequiredPositiveInteger(errors, path .. ".payload.count", payload.count)
		BuildOrderEditor_ValidateOptionalPositiveInteger(errors, path .. ".payload.vils", payload.vils)
		BuildOrderEditor_ValidateOptionalString(errors, path .. ".payload.location", payload.location)
	elseif check.kind == "age_up" then
		local ageUpKind = BuildOrderEditor_GetAgeUpDiscoveryKind(civ)
		BuildOrderEditor_ValidateAlternatives(errors, path .. ".payload.alternatives", payload.alternatives, discovery, { ageUpKind })
		BuildOrderEditor_ValidateOptionalPositiveInteger(errors, path .. ".payload.vils", payload.vils)
		BuildOrderEditor_ValidateOptionalString(errors, path .. ".payload.location", payload.location)
	elseif check.kind == "upgrades" then
		BuildOrderEditor_ValidateLiveID(errors, path .. ".payload.id", payload.id, discovery, { "upgrade" })
		BuildOrderEditor_ValidateBoolean(errors, path .. ".payload.queued", payload.queued)
	elseif check.kind == "produce" then
		BuildOrderEditor_ValidateFamily(errors, path .. ".payload.family", payload.family, discovery)
		BuildOrderEditor_ValidateRequiredPositiveInteger(errors, path .. ".payload.count", payload.count)
		BuildOrderEditor_ValidateBoolean(errors, path .. ".payload.constant", payload.constant)
		BuildOrderEditor_ValidateBoolean(errors, path .. ".payload.queued", payload.queued)
	elseif check.kind == "buildings" then
		BuildOrderEditor_ValidateLiveID(errors, path .. ".payload.id", payload.id, discovery, { "entity" })
		BuildOrderEditor_ValidateRequiredPositiveInteger(errors, path .. ".payload.count", payload.count)
	elseif check.kind == "units" then
		BuildOrderEditor_ValidateFamily(errors, path .. ".payload.family", payload.family, discovery)
		BuildOrderEditor_ValidateRequiredPositiveInteger(errors, path .. ".payload.count", payload.count)
	elseif check.kind == "hints" then
		if type(payload.text) ~= "string" or BuildOrderEditor_Trim(payload.text) == "" then
			BuildOrderEditor_AddError(errors, path .. ".payload.text", "must be a non-empty string")
		end
	end
end

function BuildOrderEditor_Validate(draft, discovery)
	local errors = {}
	if type(draft) ~= "table" then
		BuildOrderEditor_AddError(errors, "draft", "must be a build-order draft")
		return errors
	end
	if type(draft.title) ~= "string" or BuildOrderEditor_Trim(draft.title) == ""
		or BuildOrderEditor_NormalizeID(draft.title) == "" then
		BuildOrderEditor_AddError(errors, "title", "must contain a title that can form an ID")
	end
	if type(draft.civ) ~= "string" or BuildOrderEditor_Trim(draft.civ) == "" then
		BuildOrderEditor_AddError(errors, "civ", "must contain a civilization")
	end
	if type(draft.steps) ~= "table" or #draft.steps == 0 then
		BuildOrderEditor_AddError(errors, "steps", "must contain at least one step")
		return errors
	end

	for stepIndex, step in ipairs(draft.steps) do
		local stepPath = "steps." .. stepIndex
		if type(step) ~= "table" then
			BuildOrderEditor_AddError(errors, stepPath, "must be a step")
		elseif type(step.title) ~= "string" or BuildOrderEditor_Trim(step.title) == "" then
			BuildOrderEditor_AddError(errors, stepPath .. ".title", "must be a non-empty string")
		end
		if type(step) == "table" and (type(step.checks) ~= "table" or #step.checks == 0) then
			BuildOrderEditor_AddError(errors, stepPath .. ".checks", "must contain at least one check")
		elseif type(step) == "table" then
			local ageUpCount = 0
			for checkIndex, check in ipairs(step.checks) do
				local checkPath = stepPath .. ".checks." .. checkIndex
				BuildOrderEditor_ValidateCheck(errors, checkPath, check, discovery, draft.civ)
				if type(check) == "table" and check.kind == "age_up" then
					ageUpCount = ageUpCount + 1
					if ageUpCount > 1 then
						BuildOrderEditor_AddError(errors, checkPath .. ".kind", "only one age-up check is allowed per step")
					end
				end
			end
		end
	end
	return errors
end

function BuildOrderEditor_Join(values, separator)
	local result = ""
	for index, value in ipairs(values) do
		if index > 1 then
			result = result .. separator
		end
		result = result .. value
	end
	return result
end

function BuildOrderEditor_JoinSelectionLabels(selections)
	local labels = {}
	for _, selection in ipairs(selections or {}) do
		table.insert(labels, BuildOrderEditor_GetSelectionLabel(selection))
	end
	return BuildOrderEditor_Join(labels, " or ")
end

function BuildOrderEditor_ResourceTitleParts(payload)
	local parts = {}
	for _, resource in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
		if payload[resource] ~= nil then
			table.insert(parts, payload[resource] .. " " .. resource)
		end
	end
	return parts
end

function BuildOrderEditor_MakeCheckTitle(draftCheck, runtimePayload)
	local payload = draftCheck.payload or {}
	if draftCheck.kind == "vils" then
		if runtimePayload.no_collect == true then
			return "No " .. runtimePayload.resource .. " villagers"
		end
		return "Assign " .. BuildOrderEditor_Join(BuildOrderEditor_ResourceTitleParts(runtimePayload), " | ")
	elseif draftCheck.kind == "resources" then
		return "Collect at least " .. runtimePayload.count .. " " .. runtimePayload.resource
	elseif draftCheck.kind == "rallypoint" then
		return "Rally to " .. runtimePayload.resource
	elseif draftCheck.kind == "built" then
		local countLabel = ""
		if runtimePayload.count > 1 then
			countLabel = runtimePayload.count .. " "
		end
		return "Build " .. countLabel .. BuildOrderEditor_JoinSelectionLabels(payload.alternatives)
	elseif draftCheck.kind == "age_up" then
		return "Age up: " .. BuildOrderEditor_JoinSelectionLabels(payload.alternatives)
	elseif draftCheck.kind == "upgrades" then
		local label = BuildOrderEditor_GetSelectionLabel(payload.id)
		local title = "Research " .. label
		if payload.queued then
			title = "Queue " .. label .. " for research"
		end
		if draftCheck.optional then
			return "[Optional] " .. title
		end
		return title
	elseif draftCheck.kind == "produce" then
		local label = BuildOrderEditor_GetSelectionLabel(payload.family)
		if payload.constant then
			return "Constantly produce " .. label
		elseif payload.queued then
			return "Queue " .. runtimePayload.count .. " " .. label
		end
		return "Produce " .. runtimePayload.count .. " " .. label
	elseif draftCheck.kind == "buildings" then
		return "Have " .. runtimePayload.count .. " " .. BuildOrderEditor_GetSelectionLabel(payload.id)
	elseif draftCheck.kind == "units" then
		return "Have " .. runtimePayload.count .. " active " .. BuildOrderEditor_GetSelectionLabel(payload.family)
	elseif draftCheck.kind == "hints" then
		return "[HINT] " .. payload.text
	end
	return BuildOrderEditor_HumanizeID(draftCheck.kind)
end

function BuildOrderEditor_VilsToRuntime(draftCheck)
	local checks = {}
	local payload = draftCheck.payload or {}
	local noCollect = payload.no_collect
	if noCollect == nil then
		noCollect = {}
	end
	local thresholds = {}
	for _, resource in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
		if payload[resource] ~= nil then
			thresholds[resource] = payload[resource]
		end
	end
	if next(thresholds) ~= nil then
		table.insert(checks, {
			kind = "vils",
			optional = draftCheck.optional == true,
			payload = thresholds,
		})
	end
	for _, resource in ipairs(noCollect) do
		table.insert(checks, {
			kind = "vils",
			optional = draftCheck.optional == true,
			payload = {
				resource = resource,
				no_collect = true,
			},
		})
	end
	return checks
end

function BuildOrderEditor_ResourcesToRuntime(draftCheck)
	local checks = {}
	local payload = draftCheck.payload or {}
	for _, resource in ipairs(BUILD_ORDER_EDITOR_RESOURCES) do
		local count = payload[resource]
		if count ~= nil then
			table.insert(checks, {
				kind = "resources",
				optional = draftCheck.optional == true,
				payload = {
					resource = resource,
					count = count,
				},
			})
		end
	end
	return checks
end

function BuildOrderEditor_CheckToRuntime(draftCheck)
	if draftCheck.kind == "vils" then
		return BuildOrderEditor_VilsToRuntime(draftCheck)
	elseif draftCheck.kind == "resources" then
		return BuildOrderEditor_ResourcesToRuntime(draftCheck)
	end

	local payload = {}
	local optional = draftCheck.optional == true
	if draftCheck.kind == "built" or draftCheck.kind == "age_up" then
		BuildOrderEditor_SetAlternatives(payload, draftCheck.payload.alternatives)
		payload.vils = draftCheck.payload.vils
		payload.location = draftCheck.payload.location
		if draftCheck.kind == "built" then
			payload.count = draftCheck.payload.count
		end
	elseif draftCheck.kind == "produce" or draftCheck.kind == "units" then
		payload.ids = BuildOrderEditor_GetFamilyIDs(draftCheck.payload.family)
		payload.count = draftCheck.payload.count
		if draftCheck.kind == "produce" then
			payload.constant = draftCheck.payload.constant
			payload.queued = draftCheck.payload.queued
			if draftCheck.kind == "produce" and payload.constant then
				optional = true
			end
		end
	else
		payload = BuildOrderEditor_DeepCopy(draftCheck.payload)
	end
	if draftCheck.kind == "hints" then
		optional = true
	end
	return {
		{
			kind = draftCheck.kind,
			optional = optional,
			payload = payload,
		},
	}
end

function BuildOrderEditor_ToRuntime(draft)
	local errors = BuildOrderEditor_Validate(draft, nil)
	if #errors > 0 then
		return nil, nil
	end

	local orderID = BuildOrderEditor_MakeID(draft.civ, draft.title)
	if draft.original_id ~= nil and draft.civ == draft.original_civ
		and draft.title == draft.original_title then
		orderID = draft.original_id
	end
	local runtimeSteps = {}
	for stepIndex, draftStep in ipairs(draft.steps) do
		local runtimeStep = {
			title = draftStep.title,
			checks = {},
		}
		local kindOccurrences = {}
		for _, draftCheck in ipairs(draftStep.checks) do
			local converted = BuildOrderEditor_CheckToRuntime(draftCheck)
			for _, runtimeCheck in ipairs(converted) do
				kindOccurrences[draftCheck.kind] = (kindOccurrences[draftCheck.kind] or 0) + 1
				local occurrence = kindOccurrences[draftCheck.kind]
				runtimeCheck.id = orderID .. ":" .. stepIndex .. ":" .. runtimeCheck.kind .. ":" .. occurrence
				runtimeCheck.title = BuildOrderEditor_MakeCheckTitle(draftCheck, runtimeCheck.payload)
				table.insert(runtimeStep.checks, runtimeCheck)
			end
		end
		table.insert(runtimeSteps, runtimeStep)
	end

	local buildOrder = {
		id = orderID,
		civ = draft.civ,
		title = draft.title,
		steps = runtimeSteps,
	}
	if draft.source ~= nil then
		buildOrder.source = draft.source
	end
	return orderID, buildOrder
end
