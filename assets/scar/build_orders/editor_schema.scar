function BuildOrderEditorSchema_Primitive(key, label, valueType, required, adapter)
	return {
		key = key,
		label = label,
		node_type = "primitive",
		value_type = valueType,
		required = required == true,
		adapter = adapter,
	}
end

function BuildOrderEditorSchema_Enum(key, label, values, required, adapter)
	return {
		key = key,
		label = label,
		node_type = "enum",
		values = values,
		required = required == true,
		adapter = adapter,
	}
end

function BuildOrderEditorSchema_Object(key, label, fields, adapter)
	return {
		key = key,
		label = label,
		node_type = "object",
		fields = fields,
		adapter = adapter,
	}
end

function BuildOrderEditorSchema_Optional(key, label, field)
	return {
		key = key,
		label = label,
		node_type = "optional",
		field = field,
	}
end

function BuildOrderEditorSchema_List(key, label, item, minItems, adapter)
	return {
		key = key,
		label = label,
		node_type = "list",
		item = item,
		min_items = minItems or 0,
		adapter = adapter,
	}
end

