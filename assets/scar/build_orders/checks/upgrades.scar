-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("utils/localization.scar")
DynImport("utils/debug.scar")
DynImport("build_orders/checks/utils/events.scar")
DynImport("build_orders/checks/utils/pbg.scar")
DynImport("build_orders/checks/utils/queue.scar")

-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------
-- checks[check_id] = {
--   player
--   pbgs       one per `oneof` id
--   states     states[i] is the state machine for pbgs[i]
--   queued
--   completed
-- }
_bo_upgrades_data = {
    checks = {},
    num_active = 0
}

local _QUEUE_RESEARCH_FORMAT_ID = 163
local _RESEARCH_FORMAT_ID = 162
local _UPGRADE_ITEM_TYPES = { PITEM_Upgrade, PITEM_PlayerUpgrade }

local _PENDING = "pending"
local _IN_PROGRESS = "in_progress"
local _RESEARCHED = "researched"

-- Per-id transitions (from -> to) for each upgrade event. States missing from a table are unchanged
local _ON_START = { [_PENDING] = _IN_PROGRESS }
local _ON_CANCEL = { [_IN_PROGRESS] = _PENDING }
local _ON_COMPLETE = { [_PENDING] = _RESEARCHED, [_IN_PROGRESS] = _RESEARCHED }

-----------------------------------------------------------------------
-- Private Implementation
-----------------------------------------------------------------------
local function IsInvalidEvent(event)
    return event == nil or event.upgrade == nil or event.executer == nil
end

local function _AddListeners()
    if _bo_upgrades_data.num_active == 0 then
        Rule_AddGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeStart, GE_UpgradeStart)
        Rule_AddGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeCancelled, GE_UpgradeCancelled)
        Rule_AddGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeComplete, GE_UpgradeComplete)
    end
    _bo_upgrades_data.num_active = _bo_upgrades_data.num_active + 1
end

local function _DropListeners()
    _bo_upgrades_data.num_active = _bo_upgrades_data.num_active - 1
    if _bo_upgrades_data.num_active == 0 then
        print("[UpgradeCheck] All checks deactivated, removing listeners")
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeStart)
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeCancelled)
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeComplete)
    end
end

local function _IsSatisfied(check, state)
    return state == _RESEARCHED
        or (check.queued and state == _IN_PROGRESS)
end

-- The check is a disjunction over its ids' state machines
local function _Refresh(check_id, check)
    local completed = false
    for _, state in ipairs(check.states) do
        if _IsSatisfied(check, state) then
            completed = true
        end
    end

    if completed ~= check.completed then
        print("[UpgradeCheck] Marking check=" .. tostring(check_id) .. " completed=" .. tostring(completed))
        check.completed = completed
        BuildOrder_Objectives_MarkComplete(check_id, completed)
    end
end

local function _InitialStates(player, pbgs)
    local states = {}
    for i, pbg in ipairs(pbgs) do
        states[i] = Player_HasUpgrade(player, pbg) and _RESEARCHED or _PENDING
    end

    BoQueue_ForEachItem(
        player,
        _UPGRADE_ITEM_TYPES,
        function(item)
            local i = Mod_Pbg_MatchesAny(pbgs, item)
            if i ~= nil and states[i] == _PENDING then
                states[i] = _IN_PROGRESS
            end
        end
    )
    return states
end

local function _ApplyEvent(event, transitions)
    if IsInvalidEvent(event) then
        return
    end

    local owner = BoEvents_GetExecuterOwner(event)
    for check_id, check in pairs(_bo_upgrades_data.checks) do
        local i = Mod_Pbg_MatchesAny(check.pbgs, event.upgrade)
        local next_state = i ~= nil and transitions[check.states[i]] or nil
        if owner == check.player and next_state ~= nil then
            print("[UpgradeCheck] check=" .. tostring(check_id) .. " id=" .. tostring(i) ..
                " " .. tostring(check.states[i]) .. " -> " .. tostring(next_state))
            check.states[i] = next_state
            _Refresh(check_id, check)
        end
    end
end

-----------------------------------------------------------------------
-- Public Interface
-----------------------------------------------------------------------
function BuildOrder_Check_Upgrades_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "upgrades",
        BuildOrder_Check_Upgrades_Activate,
        BuildOrder_Check_Upgrades_Deactivate,
        BuildOrder_Check_Upgrades_GetText,
        BuildOrder_Check_Upgrades_Validate,
        nil
    )
end

function BuildOrder_Check_Upgrades_Validate(check)
    local t = check.payload
    return t.id ~= nil or t.oneof ~= nil
end

function BuildOrder_Check_Upgrades_Activate(obj, player)
    local check_id = obj.check.id
    if _bo_upgrades_data.checks[check_id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local ids = payload.oneof or { payload.id }
    local pbgs = Mod_Pbg_ResolveAll(ids, BP_GetUpgradeBlueprint)
    if #pbgs == 0 then
        print("[UpgradeCheck] Failed to resolve pbg: check=" .. tostring(check_id) .. " pbg=" .. table.concat(ids, ","))
        return false
    end

    -- Checks stay registered after completing because a queued upgrade can still be cancelled
    local check = {
        player = player,
        pbgs = pbgs,
        states = _InitialStates(player, pbgs),
        queued = payload.queued,
        completed = false
    }
    _bo_upgrades_data.checks[check_id] = check
    _AddListeners()
    print("[UpgradeCheck] Registered check=" .. tostring(check_id))

    _Refresh(check_id, check)
    return true
end

function BuildOrder_Check_Upgrades_Deactivate(obj)
    local check_id = obj.check.id
    if _bo_upgrades_data.checks[check_id] == nil then
        return
    end

    print("[UpgradeCheck] Deleted check=" .. tostring(check_id))
    _bo_upgrades_data.checks[check_id] = nil
    _DropListeners()
end

function BuildOrder_Check_Upgrades_GetText(obj)
    print("[UpgradeCheck] Assembling objective text")
    local payload = obj.check.payload
    local tech_name = Mod_Pbg_JoinScreenNames(
        payload.oneof or { payload.id }, BP_GetUpgradeBlueprint, BP_GetUpgradeUIInfo, "/")

    if payload.queued then
        return Loc_FormatText(BoLoc_ModStringId(_QUEUE_RESEARCH_FORMAT_ID), tech_name)
    else
        return Loc_FormatText(BoLoc_ModStringId(_RESEARCH_FORMAT_ID), tech_name)
    end
end

-----------------------------------------------------------------------
-- Public Implementation
-----------------------------------------------------------------------
function BuildOrder_Check_Upgrades_OnUpgradeStart(event)
    print("[UpgradeCheck] Received upgrade start event: " .. tostring(event))
    _ApplyEvent(event, _ON_START)
end

function BuildOrder_Check_Upgrades_OnUpgradeCancelled(event)
    print("[UpgradeCheck] Received upgrade cancel event: " .. tostring(event))
    _ApplyEvent(event, _ON_CANCEL)
end

function BuildOrder_Check_Upgrades_OnUpgradeComplete(event)
    print("[UpgradeCheck] Received upgrade complete event: " .. tostring(event))
    _ApplyEvent(event, _ON_COMPLETE)
end
