-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_upgrades_data = {
    techs = {},
    num_queued_listeners = 0,
    num_research_listeners = 0,
    num_cancel_listeners = 0
}

QUEUE_RESEARCH_FORMAT = "Queue %s for research"
RESEARCH_FORMAT = "Research %s"

-----------------------------------------------------------------------
-- Helper Functions
-----------------------------------------------------------------------

-- TODO: Similar to built.scar but for upgrades
local function ResolvePBGs(ids)
    local pbgs = []
    for _, id in ipairs(id) do
        local found, pbg = BP_GetUpgradeBlueprint(id)
        if found and pbg ~= nil then
            pbgs[#pbgs + 1] = pbg
        end
    end
    return pbgs
end

-- TODO: Not sure which one is needed yet
-- TODO: Same as buildings.scar, but without entity resolution
-- TODO: Same as units.scar
local function PBGMatches(left, right)
    return left ~= nil and right ~= nil
		and left.PropertyBagGroupID == right.PropertyBagGroupID
		and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
		and left.PropertyBagGroupType == right.PropertyBagGroupType
end

-- Similar to built.scar
local function UpgradeName(tech, id)
    if tech ~= nil and tech.pbg ~= nil then
        local resolved, uiInfo = BP_GetUpgradeUIInfo(tech.pbg)
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end
    print("Missing localization string for " .. tostring(id))
    return BuildOrder_RawText(tostring(id))
end

local function IsInvalidEvent(event)
    return event == nil or event.upgrade == nil or event.executer ~= nil
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Upgrades_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "upgrades",
        BuildOrder_Check_Upgrades_Activate,
        BuildOrder_Check_Upgrades_Deactivate,
        BuildOrder_Check_Upgrades_GetText,
        BuildOrder_Check_Upgrades_Validate,
        nil
    )
end

function BuildOrder_Check_Upgrades_Validate(check)
    local t = check.payload
    return t.id ~= nil
end

function BuildOrder_Check_Upgrades_Activate(obj, player)
    if _bo_upgrades_data.techs[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local pbgs = ResolvePBGs([payload.id])
    if #pbgs == 0 then
        return false
    end

    -- TODO: `Activate` is called before `CreateObjective`, so this
    -- techically doesn't work. We want this case to be auto-marked
    -- as complete even if we don't need any resolution
    if IsUpgradeCompleted(player, pbgs[1], payload.queued) then
        Obj_SetState(obj.obj_id, OS_Complete)
        return true
    end
 
    _bo_upgrades_data.techs[obj.check.id] = {
        obj_id = obj.obj_id,
        pbg = pbgs[1],
        queued = payload.queued,
        player = player,
        completed = false
    }

    -- TODO: Handle `IsUpgradeCompleted`/`IsUpgradeQueued`
    if payload.queued then
        AddQueuedListener()
    else
        AddCompletedListener()
    end

    return true
end

function BuildOrder_Check_Upgrades_Deactivate(obj)
    if _bo_upgrades_data.events_registered then
        DeactivateCheck(obj.check.id)
    end
end

function BuildOrder_Check_Upgrades_GetText(obj)
    local payload = obj.check.payload
    if payload.queued then
        return Loc_FormatText(QUEUE_RESEARCH_FORMAT, UpgradeName)
    else
        return Loc_FormatText(RESEARCH_FORMAT, "")
    end
end

-- TODO: Need to resolve event naming schema
-- TODO: Implement if check is through events
-- We have one event handle active for all checks in a given step
-- but we call activate/deactivate for each one
function OnUpgradeQueued(event)
    -- TODO: Might want to use slightly different check
    if IsInvalidEvent(event) then
        return
    end

    local owner = GetExecuterOwner(event)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if not state.completed
            and state.queued
            and owner == state.player
            and PBGMatches(event.upgrade, state.upgrade)
        then
            state.completed = true
            Obj_SetState(state.obj_id, OS_Complete)
            DropQueuedListener()
            AddCancelListener()
        end
    end
    -- TODO: Implement
end

function OnUpgradeCancelled(event)
    -- TODO: Might want to use slightly different check
    if IsInvalidEvent(event) then
		return
	end

	local owner = BuildOrder_GetExecuterOwner(context)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if state.completed
            and state.queued
            and owner == state.player
            and PBGMatches(event.upgrade, state.upgrade)
        then
            state.completed = false
            Obj_SetState(state.obj_id, OS_Incomplete)
            DropCancelListener()
            AddQueuedListener()
        end
    end
end

-- TODO: I think these loops where i deactivate the check in the middle
-- are incorrect. Just collect ids to delete and then run it
function OnUpgradeFinished(event)
    -- TODO: Might want to use slightly different check
    if IsInvalidEvent(event) then
		return
	end

	local owner = BuildOrder_GetExecuterOwner(context)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if owner == state.player
            and PBGMatches(event.upgrade, state.upgrade)
        then
            Obj_SetState(state.obj_id, OS_Complete)
            DeactivateCheck(check_id)
        end
    end
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------

local function AddQueuedListener()
    if _bo_upgrades_data.num_queued_listeners == 0 then
        Rule_AddGlobalEvent(OnUpgradeQueued, GE_UpgradeStart)
    end
    _bo_upgrades_data.num_queued_listeners =
        _bo_upgrades_data.num_queued_listeners + 1
end

local function AddCancelListener()
    if _bo_upgrades_data.num_cancel_listeners == 0 then
        Rule_AddGlobalEvent(
            OnUpgradeCancelled, GE_UpgradeCancelled)
    end
    _bo_upgrades_data.num_cancel_listeners =
        _bo_upgrades_data.num_cancel_listeners + 1
end

local function AddCompletedListener()
    if _bo_upgrades_data.num_research_listeners == 0 then
        Rule_AddGlobalEvent(
            OnUpgradeFinished, GE_UpgradeComplete)
    end
    _bo_upgrades_data.num_research_listeners =
        _bo_upgrades_data.num_research_listeners + 1
end

local function DropQueuedListener()
    _bo_upgrades_data.num_queued_listeners =
        _bo_upgrades_data.num_queued_listeners - 1
    if _bo_upgrades_data.num_queued_listeners == 0 then
        Rule_RemoveGlobalEvent(OnUpgradeQueued)
    end
end

local function DropCancelListener()
    _bo_upgrades_data.num_cancel_listeners =
        _bo_upgrades_data.num_cancel_listeners - 1
    if _bo_upgrades_data.num_cancel_listeners == 0 then
        Rule_RemoveGlobalEvent(OnUpgradeCancelled)
    end
end

local function DropCompletedListener()
    _bo_upgrades_data.num_research_listeners =
        _bo_upgrades_data.num_research_listeners - 1
    if _bo_upgrades_data.num_research_listeners == 0 then
        Rule_RemoveGlobalEvent(OnUpgradeFinished)
    end
end

local function GetExecuterOwner(event)
	if event.executer.PlayerID ~= nil then
		return context.executer
	end
	if event.executer.EntityID ~= nil then
		return Entity_GetPlayerOwner(context.executer)
	end
	return nil

end

local function DeactivateCheck(check_id)
    local state = _bo_upgrades_data.techs[check_id]

    if state == nil then
        return
    end

    _bo_upgrades_data.techs[check_id] = nil

    -- Remove the check from being considered by the event
    -- This also removes the event if all listeners are dropped
    if state.queued then
        if state.completed then
            DropCancelListener()
        else
            DropQueuedListener()
        end
    else
        DropCompletedListener()
    end

end

local function IsUpgradeCompleted(player, pbg, queued)
    if not queued then
        return Player_HasUpgrade(player, pbg)
    end

    local queued_upgrade = false
    EGroup_ForEach(
        Player_GetEntities(player),
        function(group, index, entity)
            if queued_upgrade then
                return
            end

            if Entity_GetPlayerOwner(entity) == player then
                local queue_size = Entity_GetProductionQueueSize(entity)
                for index = 0, queue_size - 1 do
                    local item = Entity_GetProductionQueueItem(
                        entity, index)
                    local type = Entity_GetProductionQueueItemType(
                        entity, index)
                    if (type == PITEM_Upgrade
                        or itemType == PITEM_PlayerUpgrade)
                        and PBGMatches(item, pbg)
                    then
                        queued_upgrade = true
                        return
                    end
                end
            end
        end
    )
    return queued_upgrade
end

-- TODO: Could this be the way to resolve the `obj_id` issue???
local function Upgrades_SetCheckComplete(state, complete)
	if state.checkComplete == complete then
		return
	end
	state.checkComplete = complete
	BuildOrder_SetCheckComplete(state.checkID, complete)
end