UPGRADES_STATE = {}
UPGRADES_POLLING = false
UPGRADES_EVENT_REGISTERED = false

local function Upgrades_GetExecuterOwner(context)
	if context == nil or context.executer == nil then
		return nil
	end
	if context.executer.PlayerID ~= nil then
		return context.executer
	end
	if context.executer.EntityID ~= nil then
		return Entity_GetPlayerOwner(context.executer)
	end
	return nil
end

local function Upgrades_IsCompletedResearch(state)
	return Player_HasUpgrade(state.player, state.pbg)
end

local function Upgrades_HasQueuedResearch(state)
	local entities = Player_GetEntities(state.player)
	for entityIndex = 1, EGroup_Count(entities) do
		local entity = EGroup_GetEntityAt(entities, entityIndex)
		-- Player_GetEntities is player-scoped, but retain the owner guard for converted entities.
		if entity ~= nil and Entity_GetPlayerOwner(entity) == state.player then
			for index = 0, Entity_GetProductionQueueSize(entity) - 1 do
				local itemType = Entity_GetProductionQueueItemType(entity, index)
				if (itemType == PITEM_Upgrade or itemType == PITEM_PlayerUpgrade)
					and Entity_GetProductionQueueItem(entity, index) == state.pbg then
					return true
				end
			end
		end
	end
	return false
end

local function Upgrades_TryComplete(state)
	if state == nil or state.completed then
		return
	end

	if Upgrades_IsCompletedResearch(state)
		or (state.queued and Upgrades_HasQueuedResearch(state)) then
		state.completed = true
		BuildOrder_SetCheckComplete(state.checkID, true)
	end
end

function Upgrades_Poll()
	for _, state in pairs(UPGRADES_STATE) do
		Upgrades_TryComplete(state)
	end
	Upgrades_UpdateObservers()
end

function Upgrades_OnUpgradeComplete(context)
	if context == nil or context.pbg == nil then
		return
	end

	local owner = Upgrades_GetExecuterOwner(context)
	local completedCheckIDs = {}
	for checkID, state in pairs(UPGRADES_STATE) do
		if state ~= nil and state.completed == false
			and owner == state.player
			and context.pbg == state.pbg then
			state.completed = true
			table.insert(completedCheckIDs, checkID)
		end
	end
	for _, completedCheckID in ipairs(completedCheckIDs) do
		BuildOrder_SetCheckComplete(completedCheckID, true)
	end
	Upgrades_UpdateObservers()
end

function Upgrades_UpdateObservers()
	local needsPolling = false
	local needsCompletionEvent = false
	for _, state in pairs(UPGRADES_STATE) do
		if state ~= nil and state.completed == false then
			needsCompletionEvent = true
			if state.queued and not state.completed then
				needsPolling = true
			end
		end
	end

	if needsPolling and not UPGRADES_POLLING then
		UPGRADES_POLLING = true
		Rule_Add(Upgrades_Poll)
	elseif not needsPolling and UPGRADES_POLLING then
		Rule_Remove(Upgrades_Poll)
		UPGRADES_POLLING = false
	end

	if needsCompletionEvent and not UPGRADES_EVENT_REGISTERED then
		Rule_AddGlobalEvent(Upgrades_OnUpgradeComplete, GE_UpgradeComplete)
		UPGRADES_EVENT_REGISTERED = true
	elseif not needsCompletionEvent and UPGRADES_EVENT_REGISTERED then
		Rule_RemoveGlobalEvent(Upgrades_OnUpgradeComplete)
		UPGRADES_EVENT_REGISTERED = false
	end
end

local function Upgrades_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil then
		return
	end
	if UPGRADES_STATE[check.id] ~= nil then
		return
	end

	UPGRADES_STATE[check.id] = {
		checkID = check.id,
		objectiveID = objectiveID,
		player = player,
		pbg = BP_GetUpgradeBlueprint(check.payload.id),
		queued = check.payload.queued,
		completed = false,
	}
	Upgrades_TryComplete(UPGRADES_STATE[check.id])
	Upgrades_UpdateObservers()
end

local function Upgrades_Deactivate(check, objectiveID, context)
	local state = UPGRADES_STATE[check.id]
	if state == nil then
		return
	end

	UPGRADES_STATE[check.id] = nil
	Upgrades_UpdateObservers()
end

BuildOrder_RegisterHandler("upgrades", {
	activate = Upgrades_Activate,
	deactivate = Upgrades_Deactivate,
})
