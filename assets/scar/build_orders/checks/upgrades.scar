-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("utils/localization.scar")
DynImport("utils/debug.scar")
DynImport("build_orders/checks/utils/events.scar")
DynImport("build_orders/checks/utils/pbg.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_upgrades_data = {
    techs = {},
    num_queued_listeners = 0,
    num_research_listeners = 0,
    num_cancel_listeners = 0
}

local _QUEUE_RESEARCH_FORMAT_ID = 163
local _RESEARCH_FORMAT_ID = 162

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

local function IsInvalidEvent(event)
    return event == nil or event.upgrade == nil or event.executer == nil
end

local function AddQueuedListener(check_id)
    if _bo_upgrades_data.num_queued_listeners == 0 then
        Rule_AddGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeStart, GE_UpgradeStart)
    end
    _bo_upgrades_data.num_queued_listeners =
        _bo_upgrades_data.num_queued_listeners + 1
end

local function AddCancelListener(check_id)
    if _bo_upgrades_data.num_cancel_listeners == 0 then
        Rule_AddGlobalEvent(
            BuildOrder_Check_Upgrades_OnUpgradeCancelled, GE_UpgradeCancelled)
    end
    _bo_upgrades_data.num_cancel_listeners =
        _bo_upgrades_data.num_cancel_listeners + 1
end

local function AddCompletedListener(check_id)
    if _bo_upgrades_data.num_research_listeners == 0 then
        Rule_AddGlobalEvent(
            BuildOrder_Check_Upgrades_OnUpgradeComplete, GE_UpgradeComplete)
    end
    _bo_upgrades_data.num_research_listeners =
        _bo_upgrades_data.num_research_listeners + 1
end

local function DropQueuedListener(check_id)
    _bo_upgrades_data.num_queued_listeners =
        _bo_upgrades_data.num_queued_listeners - 1
    if _bo_upgrades_data.num_queued_listeners == 0 then
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeStart)
    end
end

local function DropCancelListener(check_id)
    _bo_upgrades_data.num_cancel_listeners =
        _bo_upgrades_data.num_cancel_listeners - 1
    if _bo_upgrades_data.num_cancel_listeners == 0 then
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeCancelled)
    end
end

local function DropCompletedListener(check_id)
    _bo_upgrades_data.num_research_listeners =
        _bo_upgrades_data.num_research_listeners - 1
    if _bo_upgrades_data.num_research_listeners == 0 then
        Rule_RemoveGlobalEvent(BuildOrder_Check_Upgrades_OnUpgradeComplete)
    end
end

local function DeactivateListeners(check_id)
    local state = _bo_upgrades_data.techs[check_id]
    if state == nil then
        return
    end

    print("[UpgradeCheck] Deleted check=" .. tostring(check_id))
    _bo_upgrades_data.techs[check_id] = nil

    -- Remove the check from being considered by the event
    -- This also removes the event if all listeners are dropped
    if state.queued then
        if state.listening_cancel then
            DropCancelListener(check_id)
        else
            DropQueuedListener(check_id)
        end
    end
    DropCompletedListener(check_id)
end

-- TODO: same as ageup.scar
local function IsUpgradeCompleted(player, pbg)
    return Player_HasUpgrade(player, pbg)
end

-- TODO: same as ageup.scar
-- TODO: ageup.scar needs this function
-- technically, needs `IsUpgradeCompleted | IsUpgradeCurrentlyQueued`
local function IsUpgradeCurrentlyQueued(player, pbg, check_id)
    local queued_upgrade = false
    EGroup_ForEach(
        Player_GetEntities(player),
        function(group, index, entity)
            if queued_upgrade then
                return
            end

            if Entity_GetPlayerOwner(entity) == player then
                local queue_size = Entity_GetProductionQueueSize(entity)
                for index = 0, queue_size - 1 do
                    local item = Entity_GetProductionQueueItem(
                        entity, index)
                    local type = Entity_GetProductionQueueItemType(
                        entity, index)
                    if (type == PITEM_Upgrade or type == PITEM_PlayerUpgrade)
                        and Mod_Pbg_Equals(item, pbg)
                    then
                        print("[UpgradeCheck] Found upgrade in queue: check=" .. tostring(check_id))
                        queued_upgrade = true
                        return
                    end
                end
            end
        end
    )
    return queued_upgrade
end

local function _has_events_registered()
    return _bo_upgrades_data.num_queued_listeners > 0
        or _bo_upgrades_data.num_cancel_listeners > 0
        or _bo_upgrades_data.num_research_listeners > 0
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Upgrades_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "upgrades",
        BuildOrder_Check_Upgrades_Activate,
        BuildOrder_Check_Upgrades_Deactivate,
        BuildOrder_Check_Upgrades_GetText,
        BuildOrder_Check_Upgrades_Validate,
        nil
    )
end

function BuildOrder_Check_Upgrades_Validate(check)
    local t = check.payload
    return t.id ~= nil
end

function BuildOrder_Check_Upgrades_Activate(obj, player)
    if _bo_upgrades_data.techs[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local pbg = Mod_Pbg_Resolve(payload.id, BP_GetUpgradeBlueprint)
    if pbg == nil then
        print("[UpgradeCheck] Failed to resolve pbg: check=" .. tostring(obj.check.id) .. " pbg=" .. tostring(payload.id))
        return false
    end

    -- In case the player researched the upgrade before we got to this point
    -- If so, we don't need to do anything more as you can't unresearch techs
    if IsUpgradeCompleted(player, pbg, obj.check.id) then
        print("[UpgradeCheck] Already completed check=" .. tostring(obj.check.id))
        BuildOrder_Objectives_MarkComplete(obj.check.id, true)
        return true
    end

    print("[UpgradeCheck] Registered check=" .. tostring(obj.check.id))
    local state = {
        pbg = pbg,
        queued = payload.queued,
        player = player,
        listening_cancel = false
    }

    -- TODO: Potentially unsure on the logic here
    -- Don't need to check upgrade completed because that's done earlier
    if payload.queued then
        if IsUpgradeCurrentlyQueued(player, pbg, obj.check.id) then
            AddCancelListener(obj.check.id)
            state.listening_cancel = true

            BuildOrder_Objectives_MarkComplete(obj.check.id, true)
        else
            AddQueuedListener(obj.check.id)
        end
    end
    AddCompletedListener(obj.check.id)
    _bo_upgrades_data.techs[obj.check.id] = state

    return true
end

function BuildOrder_Check_Upgrades_Deactivate(obj)
    if _has_events_registered() then
        DeactivateListeners(obj.check.id)
    end
end

function BuildOrder_Check_Upgrades_GetText(obj)
    print("[UpgradeCheck] Assembling objective text")
    local payload = obj.check.payload
    local state = _bo_upgrades_data.techs[obj.check.id]
    local tech_name = Mod_Pbg_ScreenName(
        payload.id, state and state.pbg or nil, BP_GetUpgradeUIInfo)

    if payload.queued then
        return Loc_FormatText(BoLoc_ModStringId(_QUEUE_RESEARCH_FORMAT_ID), tech_name)
    else
        return Loc_FormatText(BoLoc_ModStringId(_RESEARCH_FORMAT_ID), tech_name)
    end
end

function BuildOrder_Check_Upgrades_OnUpgradeStart(event)
    print("[UpgradeCheck][UpgradeStart] Received upgrade queue event: " .. tostring(event))
    if IsInvalidEvent(event) then
        return
    end

    local owner = BoEvents_GetExecuterOwner(event)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if owner ~= state.player then
            return
        end

        if state.queued
            and Mod_Pbg_Equals(event.upgrade, state.pbg)
        then
            print("[UpgradeCheck][UpgradeStart] Found expected upgrade in event. Marking check=" ..
                tostring(check_id) .. " complete")
            BuildOrder_Objectives_MarkComplete(check_id, true)
            state.listening_cancel = true
            DropQueuedListener(check_id)
            AddCancelListener(check_id)
        else
            print("[UpgradeCheck][UpgradeStart] Event not for expected upgrade.")
        end
    end
end

function BuildOrder_Check_Upgrades_OnUpgradeCancelled(event)
    print("[UpgradeCheck][UpgradeCancelled] Received upgrade cancel event: " .. tostring(event))
    if IsInvalidEvent(event) then
        print("[UpgradeCheck][UpgradeCancelled] Invalid event. Leaving early")
        return
    end

    local owner = BoEvents_GetExecuterOwner(event)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if owner ~= state.player then
            print("[UpgradeCheck][UpgradeCancelled] Wrong owner for check. leaving early")
            return
        end

        if state.queued
            and Mod_Pbg_Equals(event.upgrade, state.pbg)
        then
            print("[UpgradeCheck][UpgradeCancelled] Received upgrade cancelation in event. Marking check=" ..
                tostring(check_id) .. " uncomplete")
            BuildOrder_Objectives_MarkComplete(check_id, false)
            state.listening_cancel = false
            DropCancelListener(check_id)
            AddQueuedListener(check_id)
        else
            print("[UpgradeCheck][UpgradeCancelled] Event not for expected upgrade.")
        end
    end
end

-- TODO: I think these loops where i deactivate the check in the middle
-- are incorrect. Just collect ids to delete and then run it
function BuildOrder_Check_Upgrades_OnUpgradeComplete(event)
    print("[UpgradeCheck][UpgradeComplete] Received upgrade done event: " .. tostring(event))
    if IsInvalidEvent(event) then
        return
    end

    local owner = BoEvents_GetExecuterOwner(event)
    for check_id, state in pairs(_bo_upgrades_data.techs) do
        if owner ~= state.player then
            return
        end

        if Mod_Pbg_Equals(event.upgrade, state.pbg) then
            print("[UpgradeCheck][UpgradeComplete] Found expected completion event. Marking check= " ..
                tostring(check_id) .. " complete")
            BuildOrder_Objectives_MarkComplete(check_id, true)
            DeactivateListeners(check_id)
        else
            print("[UpgradeCheck][UpgradeComplete] Event not for expected upgrade.")
        end
    end
end

