-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("utils/localization.scar")

-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------
_bo_resources_data = {}

local _COLLECT_RES_FORMAT_ID = 155

-----------------------------------------------------------------------
-- Private Implementation
-----------------------------------------------------------------------
local function GetResourceType(resource)
    if resource == "food" then
        return RT_Food
    end
    if resource == "gold" then
        return RT_Gold
    end
    if resource == "wood" then
        return RT_Wood
    end
    if resource == "stone" then
        return RT_Stone
    end
    return nil
end

-----------------------------------------------------------------------
-- Public Interface
-----------------------------------------------------------------------
function BuildOrder_Check_Resources_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "resources",
        BuildOrder_Check_Resources_Activate,
        BuildOrder_Check_Resources_Deactivate,
        BuildOrder_Check_Resources_GetText,
        BuildOrder_Check_Resources_Validate,
        BuildOrder_Check_Resources_PollCompletion
    )
end

function BuildOrder_Check_Resources_Validate(check)
    local t = check.payload
    return t.count ~= nil and t.resource ~= nil
end

function BuildOrder_Check_Resources_Activate(obj, player)
    if _bo_resources_data[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    print("[ResourceCheck] Registered check=" .. tostring(obj.check.id))
    _bo_resources_data[obj.check.id] = {
        player = player,
        resource = payload.resource,
        type = GetResourceType(payload.resource),
        count = payload.count
    }
    return true
end

function BuildOrder_Check_Resources_Deactivate(obj)
    if _bo_resources_data[obj.check.id] ~= nil then
        _bo_resources_data[obj.check.id] = nil
    end
end

function BuildOrder_Check_Resources_GetText(obj)
    local payload = obj.check.payload
    return Loc_FormatText(
        BoLoc_ModStringId(_COLLECT_RES_FORMAT_ID),
        Loc_FormatInteger(payload.count),
        BoLoc_String(payload.resource)
    )
end

-- TODO: Would be ideal if we could do all checks for a step in one go
function BuildOrder_Check_Resources_PollCompletion(obj)
    local res = _bo_resources_data[obj.check.id]
    if res == nil then
        return false
    end

    return Player_GetResource(res.player, res.type) >= res.count
end

-----------------------------------------------------------------------
-- Public Implementation
-----------------------------------------------------------------------
