-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("dynimport.scar")
import("build_orders/localization.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_resources_data = {
    res = {}
}

-- TODO: Is there any documentation on the format strings?
local _COLLECT_RES_FORMAT_ID = 155
BUILD_ORDER_RESOURCE_KEYS = {
    food = "$dfb5645698a84afb91cf7a2dfb0f4a4e:148",
    gold = "$dfb5645698a84afb91cf7a2dfb0f4a4e:149",
    wood = "$dfb5645698a84afb91cf7a2dfb0f4a4e:150",
    stone = "$dfb5645698a84afb91cf7a2dfb0f4a4e:151",
}

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

-- TODO: Same as vils.scar
-- TODO: Game is crashing saying these are nil, but the old mod used them fine? Why???
local function ResolveResourceType(res)
    if res == "food" then
        return RT_Food
    end
    if res == "gold" then
        return RT_Gold
    end
    if res == "wood" then
        return RT_Wood
    end
    if res == "stone" then
        return RT_Stone
    end
    return nil
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Resources_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "resources",
        BuildOrder_Check_Resources_Activate,
        BuildOrder_Check_Resources_Deactivate,
        BuildOrder_Check_Resources_GetText,
        BuildOrder_Check_Resources_Validate,
        BuildOrder_Check_Resources_PollCompletion
    )
end

function BuildOrder_Check_Resources_Validate(check)
    local t = check.payload
    return t.count ~= nil and t.resource ~= nil
end

function BuildOrder_Check_Resources_Activate(obj, player)
    if _bo_resources_data.res[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    _bo_resources_data.res[obj.check.id] = {
        player = player,
        type = ResolveResourceType(payload.resource),
        count = payload.count
    }
    return true
end

function BuildOrder_Check_Resources_Deactivate(obj)
    if _bo_resources_data.res[obj.check.id] == nil then
        return
    end

    _bo_resources_data.res[obj.check.id] = nil
end

function BuildOrder_Check_Resources_GetText(obj)
    print("Getting text for resources check")
    local payload = obj.check.payload
    return Loc_FormatText(
        BO_LOC_StringId(_COLLECT_RES_FORMAT_ID),
        payload.count,
        BO_LOC_ResourceName(_bo_resources_data.res[obj.check.id].type)
    )
end

-- TODO: Would be ideal if we could do all checks in one go
function BuildOrder_Check_Resources_PollCompletion(obj)
    local state = _bo_resources_data[obj.check.id]
    if state == nil then
        return false
    end

    local current = Player_GetResource(res.player, res.type)
    return current >= res.count
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
