-- TEMPORARY: rally target classification is not yet reliable, so this handler auto-completes.
function Rallypoint_FormatTitle(check, context)
	return Loc_FormatText(
		BUILD_ORDER_LOC_KEYS.rally,
		BuildOrder_ResourceName(check.payload.resource)
	)
end

local function Rallypoint_Activate(check, objectiveID, context)
	if context.localPlayer == nil then
		return
	end

	BuildOrder_SetCheckComplete(check.id, true)
end

local function Rallypoint_Deactivate(check, objectiveID, context)
end

BuildOrder_RegisterHandler("rallypoint", {
	formatTitle = Rallypoint_FormatTitle,
	activate = Rallypoint_Activate,
	deactivate = Rallypoint_Deactivate,
})
