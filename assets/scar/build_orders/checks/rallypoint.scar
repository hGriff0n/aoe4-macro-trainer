_bo_rallypoint_data = {

}

local _RALLYPOINT_TEXT = "Rally new villagers to %s"

-----------------------------------------------------------------------
-- Helper Functions
-----------------------------------------------------------------------

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Rallypoint_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "rallypoint",
        BuildOrder_Check_Rallypoint_Activate,
        BuildOrder_Check_Rallypoint_Deactivate,
        BuildOrder_Check_Rallypoint_GetText,
        BuildOrder_Check_Rallypoint_Validate,
        nil
    )
end

function BuildOrder_Check_Rallypoint_Validate(check)
    local t = check.payload
    return t.resource ~= nil
end

-- TODO: Implement rallypoint check. For now, just auto-complete
function BuildOrder_Check_Rallypoint_Activate(obj, player)
    obj.completed = true
    return true
end

function BuildOrder_Check_Rallypoint_Deactivate(obj)
end

function BuildOrder_Check_Rallypoint_GetText(obj)
    return Loc_FormatText(_RALLYPOINT_TEXT,
        BuildOrder_ResourceName(obj.check.payload.resource))
end

