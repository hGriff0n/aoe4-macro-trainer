local RALLYPOINT_STATE = {}

local function Rallypoint_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil or RALLYPOINT_STATE[check.id] ~= nil then
		return
	end

	-- The supported SCAR rally API cannot identify the rally target resource or a
	-- documented town-center construction order. The compiler presents this
	-- descriptor as optional, so keep no polling state and never infer completion.
	RALLYPOINT_STATE[check.id] = {
		player = player,
		objectiveID = objectiveID,
		payload = check.payload,
	}
end

local function Rallypoint_Deactivate(check, objectiveID, context)
	local state = RALLYPOINT_STATE[check.id]
	if state == nil then
		return
	end

	RALLYPOINT_STATE[check.id] = nil
end

BuildOrder_RegisterHandler("rallypoint", {
	activate = Rallypoint_Activate,
	deactivate = Rallypoint_Deactivate,
})
