-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Hints_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "hints",
        BuildOrder_Check_Hints_Activate,
        BuildOrder_Check_Hints_Deactivate,
        BuildOrder_Check_Hints_GetText,
        BuildOrder_Check_Hints_Validate,
        nil
    )
end

function BuildOrder_Check_Hints_Validate(check)
    local t = check.payload
    return t.text ~= nil
end

function BuildOrder_Check_Hints_Activate(obj, player)
    return true
end

function BuildOrder_Check_Hints_Deactivate(obj)
end

function BuildOrder_Check_Hints_GetText(obj)
    print("Getting text for hints check")
    return Loc_FormatText(BO_LOC_StringId(_HINT_TEXT_FORMAT), check.payload.text)
end

