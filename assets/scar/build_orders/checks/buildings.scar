-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("dynimport.scar")
import("build_orders/localization.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_buildings_data = {
    buildings = {}
}

local _BUILDINGS_FORMAT_ID = 168

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

-- TODO: Same as built.scar
local function ResolvePBGs(ids)
    local pbgs = {}
    for _, id in ipairs(ids) do
        local found, pbg = BP_GetEntityBlueprint(id)
        if found and pbg ~= nil then
            pbgs[#pbgs + 1] = pbg
        end
    end
    return pbgs
end

-- TODO: Same as built.scar, but resolves entity to pbg
local function PBGMatches(left, entity)
    local right = ResolvePBGs({ entity })[1]
    return left ~= nil and right ~= nil
        and left.PropertyBagGroupID == right.PropertyBagGroupID
        and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
        and left.PropertyBagGroupType == right.PropertyBagGroupType
end

-- TODO: Same as built.scar
local function BuildingName(building, id)
    if building ~= nil and building.pbg ~= nil then
        local resolved, uiInfo = BP_GetEntityUIInfo(building.pbg)
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end
    print("Missing localization string for " .. tostring(id))
    return BuildOrder_RawText(tostring(id))
end


-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Buildings_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "buildings",
        BuildOrder_Check_Buildings_Activate,
        BuildOrder_Check_Buildings_Deactivate,
        BuildOrder_Check_Buildings_GetText,
        BuildOrder_Check_Buildings_Validate,
        BuildOrder_Check_Buildings_PollCompletion
    )
end

-- TODO: Check compiler, don't have any examples of this check yet
function BuildOrder_Check_Buildings_Validate(check)
    local t = check.payload
    return false
end

-- TODO: This could be done via events if we got an event
-- whenever any building is deleted/destroyed
function BuildOrder_Check_Buildings_Activate(obj, player)
    -- TODO: Potentially a race-condition?
    if _bo_buildings_data.buildings[obj.check.id] ~= nil then
        return false
    end

    local pbgs = ResolvePBGs({ obj.check.payload.id })
    if #pbgs == 0 then
        return false
    end

    _bo_buildings_data.buildings[obj.check.id] = {
        pbg = pbgs[1],
        count = obj.check.payload.count,
        player = player
    }
    return true
end

function BuildOrder_Check_Buildings_Deactivate(obj)
    if _bo_buildings_data.buildings[obj.check.id] == nil then
        return
    end

    _bo_buildings_data.buildings[obj.check.id] = nil
end

function BuildOrder_Check_Buildings_GetText(obj)
    print("Getting text for building check")
    local payload = obj.check.payload
    return Loc_FormatText(
        BO_LOC_StringId(_BUILDINGS_FORMAT_ID),
        payload.count,
        BuildingName(
            _bo_buildings_data.buildings[obj.check.id], payload.id)
    )
end

-- TODO: Would be ideal if we could do all checks in one go
function BuildOrder_Check_Buildings_PollCompletion(obj)
    local state = _bo_buildings_data[obj.check.id].buildings
    if state == nil then
        return false
    end

    local count = 0
    EGroup_ForEach(
        Player_GetEntities(state.player),
        function(groupId, entityIdx, entity)
            if Entity_GetPlayerOwner(entity) == state.player
                and not Entity_IsBuilding(entity)
                and Entity_GetBuildingProgress(entity) >= 1.0
                and PBGMatches(state.pbg, entity)
            then
                count = count + 1
            end
        end
    )
    return count >= obj.check.payload.count
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
