PRODUCE_STATE = {}
PRODUCE_QUEUE_STATE = nil
PRODUCE_POLLING = false

function Produce_ScanQueueEntity(groupID, entityIndex, entity)
	local state = PRODUCE_QUEUE_STATE
	if state == nil then
		return true
	end
	if Entity_GetPlayerOwner(entity) ~= state.player then
		return false
	end
	if Entity_HasProductionQueue(entity) == false then
		return false
	end

	local queueSize = Entity_GetProductionQueueSize(entity)
	for index = 0, queueSize - 1 do
		if Entity_GetProductionQueueItemType(entity, index) == PITEM_Spawn
			and Entity_GetProductionQueueItem(entity, index) == BP_GetSquadBlueprint(state.payload.id) then
			state.queueCount = state.queueCount + 1
		end
	end
	return false
end

function Produce_QueueHasCount(state)
	state.queueCount = 0
	PRODUCE_QUEUE_STATE = state
	EGroup_ForEach(Player_GetEntities(state.player), Produce_ScanQueueEntity)
	PRODUCE_QUEUE_STATE = nil
	return state.queueCount >= state.payload.count
end

function Produce_Poll()
	for _, state in pairs(PRODUCE_STATE) do
		BuildOrder_SetCheckComplete(state.checkID, Produce_QueueHasCount(state))
	end
end

function Produce_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil then
		return
	end

	if check.payload.queued == false or check.payload.constant then
		-- Normal completion and uninterrupted production lack a documented scoped signal.
		return
	end

	local addRule = next(PRODUCE_STATE) == nil
	PRODUCE_STATE[check.id] = {
		checkID = check.id,
		objectiveID = objectiveID,
		player = player,
		payload = check.payload,
	}
	if addRule then
		PRODUCE_POLLING = true
		Rule_Add(Produce_Poll)
	end
	BuildOrder_SetCheckComplete(check.id, Produce_QueueHasCount(PRODUCE_STATE[check.id]))
end

function Produce_Deactivate(check, objectiveID, context)
	local state = PRODUCE_STATE[check.id]
	if state == nil then
		return
	end

	PRODUCE_STATE[check.id] = nil
	if next(PRODUCE_STATE) == nil and PRODUCE_POLLING then
		Rule_Remove(Produce_Poll)
		PRODUCE_POLLING = false
	end
end

BuildOrder_RegisterHandler("produce", {
	activate = Produce_Activate,
	deactivate = Produce_Deactivate,
})
