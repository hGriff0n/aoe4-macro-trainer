-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")
import("utils/debug.scar")

DynImport("utils/localization.scar")
DynImport("build_orders/checks/utils/pbg.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_produce_data = {
    units = {},
    num_build_listeners = 0,
    num_command_listeners = 0
}

local _CONSTANT_PROD_FORMAT_ID = 166
local _QUEUE_UNIT_FORMAT_ID = 165
local _PROD_UNIT_FORMAT_ID = 164

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

local function IsInvalidEvent(event)
    return event == nil or event.player == nil or event.pbg == nil
end

local function QueuedItemIsCheckMatch(entity, index, pbgs)
    return Entity_GetProductionQueueItemType(entity, index) == PITEM_Spawn
        and Mod_Pbg_MatchesAny(
            pbgs, Entity_GetProductionQueueItem(entity, index)) ~= nil
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Produce_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "produce",
        BuildOrder_Check_Produce_Activate,
        BuildOrder_Check_Produce_Deactivate,
        BuildOrder_Check_Produce_GetText,
        BuildOrder_Check_Produce_Validate,
        nil
    )
end

function BuildOrder_Check_Produce_Validate(check)
    local t = check.payload
    return t.ids ~= nil and (t.constant ~= nil or t.count ~= nil)
end

-- child = {
--   obj_id
--   check
--   parent_id
--   completed
--   poll_completion_handle (for non-event only)
-- }
function BuildOrder_Check_Produce_Activate(obj, player)
    if _bo_produce_data.units[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local pbgs = Mod_Pbg_ResolveAll(payload.ids, BP_GetSquadBlueprint)
    if #pbgs == 0 then
        print("[ProduceCheck] Failed to resolve pbg: check=" ..
            tostring(obj.check.id) .. " pbg=" .. tostring(obj.check.payload.id))
        return false
    end

    print("[ProduceCheck] Registered check=" .. tostring(obj.check.id))
    _bo_produce_data.units[obj.check.id] = {
        player = player,
        pbgs = pbgs,
        minimum = payload.count ~= nil and payload.count or 1,
        num_built = 0,
        queued = payload.queued,
        constant = payload.constant
    }
    -- Instead of trying to check for "constant" production,
    -- we only check for a single unit to be produced. "Constant"
    -- production is more of an optimization to be tracked via metrics
    if payload.constant then
        _bo_produce_data.units[obj.check.id].minimum = 1
    end

    -- TODO: Might want to send both cases through the build events
    -- It's fine to only send queued checks through command though
    if payload.queued then
        if _bo_produce_data.num_command_listeners == 0 then
            Rule_AddGlobalEvent(
                BuildOrder_Check_Produce_OnEntityCommandIssued,
                GE_EntityCommandIssued
            )
        end
        _bo_produce_data.num_command_listeners =
            _bo_produce_data.num_command_listeners + 1
    else
        if _bo_produce_data.num_build_listeners == 0 then
            Rule_AddGlobalEvent(
                BuildOrder_Check_Produce_OnBuildItemComplete,
                GE_BuildItemComplete
            )
        end
        _bo_produce_data.num_build_listeners =
            _bo_produce_data.num_build_listeners + 1
    end

    return true
end

function BuildOrder_Check_Produce_Deactivate(obj)
    local check_id = obj.check.id
    if _bo_produce_data.units[check_id] == nil then
        return
    end

    -- Only remove the event handler if all checks are deactivated
    -- since a single step can have multiple checks of the same kind
    if _bo_produce_data.units[check_id].queued then
        _bo_produce_data.num_command_listeners =
            _bo_produce_data.num_command_listeners - 1
        if _bo_produce_data.num_command_listeners == 0 then
            print("[ProduceCheck] All entity checks deactiated, removing listener")
            Rule_RemoveGlobalEvent(BuildOrder_Check_Produce_OnEntityCommandIssued)
        end
    else
        _bo_produce_data.num_build_listeners =
            _bo_produce_data.num_build_listeners - 1
        if _bo_produce_data.num_build_listeners == 0 then
            print("[ProduceCheck] All build checks deactiated, removing listener")
            Rule_RemoveGlobalEvent(BuildOrder_Check_Produce_OnBuildItemComplete)
        end
    end

    _bo_produce_data.units[check_id] = nil
end

function BuildOrder_Check_Produce_GetText(obj)
    local payload = obj.check.payload
    local units = _bo_produce_data.units[obj.check.id]
    local unit_text = Mod_Pbg_ScreenName(
        payload.ids[1],
        units ~= nil and units.pbgs[1] or nil,
        BP_GetSquadUIInfo,
        units ~= nil and units.player or nil
    )

    if payload.constant then
        return Loc_FormatText(BoLoc_ModStringId(_CONSTANT_PROD_FORMAT_ID), unit_text)
    elseif payload.queued then
        return Loc_FormatText(
            BoLoc_ModStringId(_QUEUE_UNIT_FORMAT_ID), Loc_FormatInteger(payload.count or 1), unit_text)
    else
        return Loc_FormatText(
            BoLoc_ModStringId(_PROD_UNIT_FORMAT_ID), Loc_FormatInteger(payload.count or 1), unit_text)
    end
end

local function _check_if_minimum_met(check_id, num_counting, minium)
    if num_counting >= minimum then
        print("[ProduceCheck] Expected num events seen. Marking " .. tostring(check_id) .. " complete")
        BuildOrder_Objectives_MarkComplete(check_id, true)
        BuildOrder_Check_Produce_Deactivate({check={ id=check_id }})
        return
    end
end

function BuildOrder_Check_Produce_OnBuildItemComplete(event)
    print("[ProduceCheck] Received unit build event: " .. tostring(event))
    if IsInvalidEvent(event) then
        return
    end

    for check_id, state in pairs(_bo_produce_data.units) do
        -- TODO: Might be worth skipping the `state.queued` filter
        if event.player == state.player and not state.queued then
            -- TODO: We'll want to redo this for constant
            -- if we ever get to adding telemetry
            if Mod_Pbg_MatchesAny(state.pbgs, event.pbg) ~= nil then
                state.num_built = state.num_built + 1
                _check_if_minimum_met(state.num_built, state.minimum, check_id)
                return
            end
        end
    end

    print("[ProduceCheck] No matching listener found for event")
end

-- Only used for checking the number of queued elements
-- Don't need to check built because a unit has to be queued first
function BuildOrder_Check_Produce_OnEntityCommandIssued(event)
    print("[ProduceCheck] Received entity command event: " .. tostring(event))
    if IsInvalidEvent(event) then
        return
    end

    local owner = Entity_GetPlayerOwner(event.entity)
    if owner == nil or not Entity_HasProductionQueue(event.entity) then
        return
    end

    for check_id, state in pairs(_bo_produce_data.units) do
        if not state.queued or state.player ~= owner then
            goto continue
        end

        -- TODO: This is not an ideal way of handling queued as it
        -- only considers the active queue. If the queued entity completes
        -- at some point, it is lost to this method of tracking.
        -- TODO: Maybe track "queued" and "built" separately in this case
        -- We already subscribe to the build event, so we simply increment
        -- the num built and add it to num queued
        -- Or just increment everytime we get a new queue?
        local num_queued = 0
        EGroup_ForEach(
            Player_GetEntities(state.player),
            function(groupID, entityIndex, entity)
                local queue_size = Entity_GetProductionQueueSize(entity)
                for index = 0, queue_size - 1 do
                    if QueuedItemIsCheckMatch(entity, index, state.pbgs) then
                        num_queued = num_queued + 1
                    end
                end
            end
        )

        _check_if_minimum_met(check_id, num_queued, state.minimum)
        ::continue::
    end
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
