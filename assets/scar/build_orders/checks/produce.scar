PRODUCE_STATE = {}
PRODUCE_SCAN_STATE = nil
PRODUCE_SNAPSHOT_STATE = nil
PRODUCE_QUEUE_STATE = nil
PRODUCE_POLLING = false

function Produce_OnCompletedSquad(checkID, squad)
	local state = PRODUCE_STATE[checkID]
	if state == nil or state.remaining == 0 then
		return
	end
	if Squad_GetPlayerOwner(squad) ~= state.player then
		return
	end
	if Squad_GetBlueprint(squad) ~= BP_GetSquadBlueprint(state.payload.id) then
		return
	end

	state.remaining = state.remaining - 1
	if state.remaining == 0 then
		BuildOrder_SetCheckComplete(checkID, true)
	end
end

function Produce_ScanSquad(groupID, squadIndex, squad)
	local state = PRODUCE_SCAN_STATE
	if state == nil then
		return true
	end
	if Squad_GetPlayerOwner(squad) ~= state.player then
		return false
	end
	if Squad_GetBlueprint(squad) ~= BP_GetSquadBlueprint(state.payload.id) then
		return false
	end

	local squadID = Squad_GetID(squad)
	if state.seen[squadID] ~= true then
		state.seen[squadID] = true
		Produce_OnCompletedSquad(state.checkID, squad)
	end
	return false
end

function Produce_SnapshotSquad(groupID, squadIndex, squad)
	local state = PRODUCE_SNAPSHOT_STATE
	if state == nil then
		return true
	end
	if Squad_GetPlayerOwner(squad) ~= state.player then
		-- Player_GetSquads is player-scoped, but retain the owner guard for converted squads.
		return false
	end
	state.seen[Squad_GetID(squad)] = true
	return false
end

function Produce_ScanNewSquads(state)
	PRODUCE_SCAN_STATE = state
	SGroup_ForEach(Player_GetSquads(state.player), Produce_ScanSquad)
	PRODUCE_SCAN_STATE = nil
end

function Produce_ScanQueueEntity(groupID, entityIndex, entity)
	local state = PRODUCE_QUEUE_STATE
	if state == nil then
		return true
	end
	if Entity_GetPlayerOwner(entity) ~= state.player then
		return false
	end
	if Entity_HasProductionQueue(entity) == false then
		return false
	end

	local queueSize = Entity_GetProductionQueueSize(entity)
	for index = 0, queueSize - 1 do
		if Entity_GetProductionQueueItemType(entity, index) == PITEM_Spawn
			and Entity_GetProductionQueueItem(entity, index) == BP_GetSquadBlueprint(state.payload.id) then
			state.queueCount = state.queueCount + 1
		end
	end
	return false
end

function Produce_QueueHasCount(state)
	state.queueCount = 0
	PRODUCE_QUEUE_STATE = state
	EGroup_ForEach(Player_GetEntities(state.player), Produce_ScanQueueEntity)
	PRODUCE_QUEUE_STATE = nil
	return state.queueCount >= state.payload.count
end

function Produce_ConstantSatisfied(state)
	-- No documented player-scoped API can prove uninterrupted production across idle gaps.
	return false
end

function Produce_Poll()
	for _, state in pairs(PRODUCE_STATE) do
		if state.payload.constant then
			Produce_ConstantSatisfied(state)
		elseif state.payload.queued then
			BuildOrder_SetCheckComplete(state.checkID, Produce_QueueHasCount(state))
		else
			Produce_ScanNewSquads(state)
		end
	end
end

function Produce_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil then
		return
	end

	local addRule = next(PRODUCE_STATE) == nil
	PRODUCE_STATE[check.id] = {
		checkID = check.id,
		objectiveID = objectiveID,
		player = player,
		payload = check.payload,
		remaining = check.payload.count,
		seen = {},
	}
	PRODUCE_SNAPSHOT_STATE = PRODUCE_STATE[check.id]
	SGroup_ForEach(Player_GetSquads(player), Produce_SnapshotSquad)
	PRODUCE_SNAPSHOT_STATE = nil
	if addRule then
		PRODUCE_POLLING = true
		Rule_Add(Produce_Poll)
	end
	if check.payload.queued and check.payload.constant == false then
		BuildOrder_SetCheckComplete(check.id, Produce_QueueHasCount(PRODUCE_STATE[check.id]))
	end
end

function Produce_Deactivate(check, objectiveID, context)
	local state = PRODUCE_STATE[check.id]
	if state == nil then
		return
	end

	PRODUCE_STATE[check.id] = nil
	if next(PRODUCE_STATE) == nil and PRODUCE_POLLING then
		Rule_Remove(Produce_Poll)
		PRODUCE_POLLING = false
	end
end

BuildOrder_RegisterHandler("produce", {
	activate = Produce_Activate,
	deactivate = Produce_Deactivate,
})
