PRODUCE_STATE = {}
PRODUCE_QUEUE_STATE = nil
PRODUCE_RECOUNT_PENDING = {}
PRODUCE_RECOUNT_RULE_ACTIVE = false
PRODUCE_COMMAND_EVENT_REGISTERED = false
PRODUCE_COMPLETION_EVENT_REGISTERED = false

local function Produce_BlueprintsEqual(left, right)
	return left.PropertyBagGroupID == right.PropertyBagGroupID
		and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
		and left.PropertyBagGroupType == right.PropertyBagGroupType
end

function Produce_ResolvePBGs(ids)
	local pbgs = {}
	for _, id in ipairs(ids) do
		table.insert(pbgs, BP_GetSquadBlueprint(id))
	end
	return pbgs
end

function Produce_MatchesPBG(pbgs, pbg)
	for _, candidate in ipairs(pbgs) do
		if Produce_BlueprintsEqual(candidate, pbg) then
			return true
		end
	end
	return false
end

function Produce_ScanQueueEntity(groupID, entityIndex, entity)
	local state = PRODUCE_QUEUE_STATE
	if state == nil then
		return true
	end
	if Entity_GetPlayerOwner(entity) ~= state.player then
		return false
	end
	if Entity_HasProductionQueue(entity) == false then
		return false
	end

	local queueSize = Entity_GetProductionQueueSize(entity)
	for index = 0, queueSize - 1 do
		if Entity_GetProductionQueueItemType(entity, index) == PITEM_Spawn
			and Produce_MatchesPBG(state.pbgs, Entity_GetProductionQueueItem(entity, index)) then
			state.queueCount = state.queueCount + 1
		end
	end
	return false
end

local function Produce_QueueHasCount(state)
	state.queueCount = 0
	PRODUCE_QUEUE_STATE = state
	EGroup_ForEach(Player_GetEntities(state.player), Produce_ScanQueueEntity)
	PRODUCE_QUEUE_STATE = nil
	return state.queueCount >= state.payload.count
end

function Produce_ReconcileQueuedNextTick()
	Rule_RemoveMe()
	PRODUCE_RECOUNT_RULE_ACTIVE = false

	local pending = PRODUCE_RECOUNT_PENDING
	PRODUCE_RECOUNT_PENDING = {}
	for _, state in pairs(PRODUCE_STATE) do
		if state ~= nil and state.payload.queued and pending[state.checkID] == true then
			BuildOrder_SetCheckComplete(state.checkID, Produce_QueueHasCount(state))
		end
	end
end

function Produce_ScheduleQueueReconciliation(checkID)
	if checkID == nil or PRODUCE_RECOUNT_PENDING[checkID] == true then
		return
	end

	PRODUCE_RECOUNT_PENDING[checkID] = true
	if PRODUCE_RECOUNT_RULE_ACTIVE == false then
		PRODUCE_RECOUNT_RULE_ACTIVE = true
		Rule_Add(Produce_ReconcileQueuedNextTick)
	end
end

function Produce_OnEntityCommandIssued(context)
	if context == nil or context.entity == nil or context.entity.EntityID == nil then
		return
	end

	local owner = Entity_GetPlayerOwner(context.entity)
	if owner == nil then
		return
	end
	if Entity_HasProductionQueue(context.entity) == false then
		return
	end

	for _, state in pairs(PRODUCE_STATE) do
		if state ~= nil and state.payload.queued and owner == state.player then
			Produce_ScheduleQueueReconciliation(state.checkID)
		end
	end
end

function Produce_OnBuildItemComplete(context)
	if context == nil or context.player == nil then
		return
	end

	for checkID, state in pairs(PRODUCE_STATE) do
		if state ~= nil and context.player == state.player then
			if state.payload.queued then
				-- Completion does not identify the producer; recount every human queue next tick.
				Produce_ScheduleQueueReconciliation(state.checkID)
			elseif state.remaining > 0 and context.pbg ~= nil and context.spawnedSquad ~= nil then
				if Produce_MatchesPBG(state.pbgs, context.pbg) then
					local squadID = context.spawnedSquad.SquadID
					if state.seen[squadID] ~= true then
						state.seen[squadID] = true
						state.remaining = state.remaining - 1
						if state.remaining == 0 then
							BuildOrder_SetCheckComplete(checkID, true)
						end
					end
				end
			end
		end
	end
end

local function Produce_EnsureCommandEventRegistered()
	if PRODUCE_COMMAND_EVENT_REGISTERED then
		return
	end

	Rule_AddGlobalEvent(Produce_OnEntityCommandIssued, GE_EntityCommandIssued)
	PRODUCE_COMMAND_EVENT_REGISTERED = true
end

local function Produce_EnsureCompletionEventRegistered()
	if PRODUCE_COMPLETION_EVENT_REGISTERED then
		return
	end

	Rule_AddGlobalEvent(Produce_OnBuildItemComplete, GE_BuildItemComplete)
	PRODUCE_COMPLETION_EVENT_REGISTERED = true
end

local function Produce_UpdateObservers()
	local needsQueuedCommands = false
	local needsCompletion = false
	for _, state in pairs(PRODUCE_STATE) do
		if state.payload.queued then
			needsQueuedCommands = true
			needsCompletion = true
		elseif state.remaining > 0 then
			needsCompletion = true
		end
	end

	if needsQueuedCommands then
		Produce_EnsureCommandEventRegistered()
	elseif PRODUCE_COMMAND_EVENT_REGISTERED then
		Rule_RemoveGlobalEvent(Produce_OnEntityCommandIssued)
		PRODUCE_COMMAND_EVENT_REGISTERED = false
	end

	if needsCompletion then
		Produce_EnsureCompletionEventRegistered()
	elseif PRODUCE_COMPLETION_EVENT_REGISTERED then
		Rule_RemoveGlobalEvent(Produce_OnBuildItemComplete)
		PRODUCE_COMPLETION_EVENT_REGISTERED = false
	end

	if needsQueuedCommands == false then
		PRODUCE_RECOUNT_PENDING = {}
		if PRODUCE_RECOUNT_RULE_ACTIVE then
			Rule_Remove(Produce_ReconcileQueuedNextTick)
			PRODUCE_RECOUNT_RULE_ACTIVE = false
		end
	end
end

function Produce_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil then
		return
	end

	if check.payload.constant then
		-- No verified signal or API proves uninterrupted production across idle gaps.
		return
	end

	PRODUCE_STATE[check.id] = {
		checkID = check.id,
		objectiveID = objectiveID,
		player = player,
		payload = check.payload,
		pbgs = Produce_ResolvePBGs(check.payload.ids),
		remaining = check.payload.count,
		seen = {},
	}
	Produce_UpdateObservers()
	if check.payload.queued then
		BuildOrder_SetCheckComplete(check.id, Produce_QueueHasCount(PRODUCE_STATE[check.id]))
	end
end

function Produce_Deactivate(check, objectiveID, context)
	local state = PRODUCE_STATE[check.id]
	if state == nil then
		return
	end

	PRODUCE_STATE[check.id] = nil
	Produce_UpdateObservers()
end

BuildOrder_RegisterHandler("produce", {
	activate = Produce_Activate,
	deactivate = Produce_Deactivate,
})
