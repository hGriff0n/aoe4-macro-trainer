-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_vils_data = {
    active = {}
}

VIL_4RES = "Assign %d %s | %d %s | %d %s | %d %s"
VIL_3RES = "Assign %d %s | %d %s | %d %s"
VIL_2RES = "Assign %d %s | %d %s"
VIL_1RES = "Assign %d %s"

-----------------------------------------------------------------------
-- Helper Functions
-----------------------------------------------------------------------

-- TODO: This is a common function
local function RequireNumber(val)
    if type(val) ~= "number" then
        return 0
    end
    return val
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Vils_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "vils",
        BuildOrder_Check_Vils_Activate,
        BuildOrder_Check_Vils_Deactivate,
        BuildOrder_Check_Vils_GetText,
        BuildOrder_Check_Vils_Validate,
        BuildOrder_Check_Vils_PollCompletion
    )
end

function BuildOrder_Check_Vils_Validate(check)
    local t = check.payload
    return #t <= 4 and t["food"] ~= nil or t["gold"] ~= nil or t["wood"] ~= nil or t["stone"] ~= nil
end

function BuildOrder_Check_Vils_Activate(obj, player)
    if _bo_vils_data.active[obj.check.id] ~= nil then
        return false
    end

    _bo_vils_data.active[obj.check.id] = {
        player = player
    }
    return true
end

function BuildOrder_Check_Vils_Deactivate(obj)
    if _bo_vils_data.active[obj.check.id] == nil then
        return
    end

    _bo_vils_data.active[obj.check.id] = nil
end

function BuildOrder_Check_Vils_GetText(obj)
    local res = GetPayloadAsList(obj.check.payload)
    if #res == 4 then
        return Loc_FormatText(
            VIL_4RES,
            res[1].key, res[1].value,
            res[2].key, res[2].value,
            res[3].key, res[3].value,
            res[4].key, res[4].value
        )
    elseif #res == 3 then
        return Loc_FormatText(
            VIL_3RES,
            res[1].key, res[1].value,
            res[2].key, res[2].value,
            res[3].key, res[3].value
        )
    elseif #res == 2 then
        return Loc_FormatText(
            VIL_2RES,
            res[1].key, res[1].value,
            res[2].key, res[2].value
        )
    elseif #res == 1 then
        return Loc_FormatText(VIL_1RES, res[1].key, res[1].value)
    end
end

function BuildOrder_Check_Vils_PollCompletion(obj)
    local state = _bo_vils_data.active[obj.check.id]
    if state == nil then
        return false
    end

    -- TODO: Is this how I want to pass around the player?
    local player = state.player
    local payload = obj.check.payload

    -- Then check if each resource assignment is being met
    local passes = true
    if payload.food ~= nil then
        passes = passes and GetVilsOnFood(player) >= payload.food
    end
    if payload.gold ~= nil then
        passes = passes and GetVilsOnGold(player) >= payload.gold
    end
    if payload.wood ~= nil then
        passes = passes and GetVilsOnWood(player) >= payload.wood
    end
    if payload.stone ~= nil then
        passes = passes and GetVilsOnStone(player) >= payload.stone
    end

    return passes
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------

local function GetPayloadAsList(payload)
    local resources = []
    for k, v in pairs(payload) do
        resources[#resource + 1] = { key: k, value: v }
    end
    return resources
end

local function GetPayloadResourcesAsKeyString(payload)
    local key = ""
    if payload.food ~= nil then
        key = key + "F"
    end
    if payload.gold ~= nil then
        key = key + "G"
    end
    if payload.wood ~= nil then
        key = key + "W"
    end
    if payload.stone ~= nil then
        key = key + "S"
    end
    return key
end

local function GetVilsOnResource(player, resource)
    if resource == "Food" then
        return GetVilsOnFood(player)
    elseif resource = "Gold" then
        return GetVilsOnGold(player)
    elseif resource = "Wood" then
        return GetVilsOnWood(player)
    elseif resource = "Stone" then
        return GetVilsOnStone(player)
    else
        return 0
    end
end

local function GetVilsOnFood(player)
    return RequireNumber(Player_GetNumGatheringSquads(player, RT_Food))
end

local function GetVilsOnGold(player)
    return RequireNumber(Player_GetNumGatheringSquads(player, RT_Gold))
end

local function GetVilsOnWood(player)
    return RequireNumber(Player_GetNumGatheringSquads(player, RT_Wood))
end

local function GetVilsOnStone(player)
    return RequireNumber(Player_GetNumGatheringSquads(player, RT_Stone))
end
