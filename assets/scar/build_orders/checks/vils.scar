-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("utils/localization.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_vils_data = {}

local _VIL_RES_PAIR_ID = 152

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

local function num_or_zero(val)
    if type(val) ~= "number" then
        return 0
    end
    return val
end

local function GetVilsOnFood(player)
    return num_or_zero(Player_GetNumGatheringSquads(player, RT_Food))
end

local function GetVilsOnGold(player)
    return num_or_zero(Player_GetNumGatheringSquads(player, RT_Gold))
end

local function GetVilsOnWood(player)
    return num_or_zero(Player_GetNumGatheringSquads(player, RT_Wood))
end

local function GetVilsOnStone(player)
    return num_or_zero(Player_GetNumGatheringSquads(player, RT_Stone))
end

local function _vilcheck(player, req, reader)
    if req == nil or req == 0 then
        return true
    end

    return reader(player) >= req
end

local function _resource_pair_formatter(res, count)
    return Loc_FormatText(
        BoLoc_ModStringId(_VIL_RES_PAIR_ID), Loc_FormatInteger(count), BoLoc_String(res))
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Vils_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "vils",
        BuildOrder_Check_Vils_Activate,
        BuildOrder_Check_Vils_Deactivate,
        BuildOrder_Check_Vils_GetText,
        BuildOrder_Check_Vils_Validate,
        BuildOrder_Check_Vils_PollCompletion
    )
end

function BuildOrder_Check_Vils_Validate(check)
    local t = check.payload
    return t.food ~= nil or t.gold ~= nil or t.wood ~= nil or t.stone ~= nil
end

function BuildOrder_Check_Vils_Activate(obj, player)
    if _bo_vils_data[obj.check.id] ~= nil then
        return false
    end

    print("[VilCheck] Registered check=" .. tostring(obj.check.id))
    _bo_vils_data[obj.check.id] = {
        player = player
    }
    return true
end

function BuildOrder_Check_Vils_Deactivate(obj)
    if _bo_vils_data[obj.check.id] == nil then
        return
    end

    print("[VilCheck] Deleted check=" .. tostring(obj.check.id))
    _bo_vils_data[obj.check.id] = nil
end

function BuildOrder_Check_Vils_GetText(obj)
    return BoLoc_ConcatStrings(
        "Assign ", BoLoc_JoinStrings(obj.check.payload, _resource_pair_formatter, "|"))
end

function BuildOrder_Check_Vils_PollCompletion(obj)
    local state = _bo_vils_data[obj.check.id]
    if state == nil then
        print("[VilCheck] No check tracked for child " .. tostring(obj.check.id))
        return false
    end

    local player = state.player
    local payload = obj.check.payload

    -- Then check if each resource assignment is being met
    return
        _vilcheck(player, payload.food, GetVilsOnFood)
        and _vilcheck(player, payload.gold, GetVilsOnGold)
        and _vilcheck(player, payload.wood, GetVilsOnWood)
        and _vilcheck(player, payload.stone, GetVilsOnStone)
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
