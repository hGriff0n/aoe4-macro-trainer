UNITS_STATE = {}
UNITS_POLLING = false
UNITS_SCAN_STATE = nil
UNITS_POLL_INTERVAL_SECONDS = 1

function Units_ScanSquad(groupID, squadIndex, squad)
	local state = UNITS_SCAN_STATE
	if state == nil then
		return true
	end
	-- Player_GetSquads is player-scoped, but retain the owner guard for converted squads.
	if Squad_GetPlayerOwner(squad) ~= state.player then
		return false
	end
	if Squad_GetBlueprint(squad) ~= state.pbg then
		return false
	end
	if Squad_IsAlive(squad) == false then
		return false
	end
	state.count = state.count + 1
	return false
end

function Units_Poll()
	for _, state in pairs(UNITS_STATE) do
		state.count = 0
		if state.pbg ~= nil then
			UNITS_SCAN_STATE = state
			SGroup_ForEach(Player_GetSquads(state.player), Units_ScanSquad)
		end
		UNITS_SCAN_STATE = nil
		BuildOrder_SetCheckComplete(state.checkID, state.count >= state.payload.count)
	end
end

function Units_Activate(check, objectiveID, context)
	local player = context.localPlayer
	if player == nil then
		return
	end

	UNITS_STATE[check.id] = {
		checkID = check.id,
		player = player,
		objectiveID = objectiveID,
		payload = check.payload,
		pbg = BP_GetSquadBlueprint(check.payload.id),
		count = 0,
	}
	if UNITS_POLLING == false then
		UNITS_POLLING = true
		Rule_AddInterval(Units_Poll, UNITS_POLL_INTERVAL_SECONDS)
	end
	Units_Poll()
end

function Units_Deactivate(check, objectiveID, context)
	local state = UNITS_STATE[check.id]
	if state == nil then
		return
	end

	UNITS_STATE[check.id] = nil
	if next(UNITS_STATE) == nil and UNITS_POLLING then
		Rule_Remove(Units_Poll)
		UNITS_POLLING = false
	end
end

BuildOrder_RegisterHandler("units", {
	activate = Units_Activate,
	deactivate = Units_Deactivate,
})
