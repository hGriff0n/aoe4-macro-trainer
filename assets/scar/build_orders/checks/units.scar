-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("build_orders/localization.scar")
DynImport("build_orders/checks/utils/pbg.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_units_data = {

}

local _ACTIVE_UNITS_FORMAT_ID = 167

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

local function MatchesAnyBlueprint(pbgs, blueprint)
    if pbgs == nil then
        return false
    end

    for _, pbg in ipairs(pbgs) do
        if Mod_Pbg_Equals(pbg, blueprint) then
            return true
        end
    end
    return false
end

local _ScreenNameWrapper(units, id, player)
    local prace = Player_GetRace(player)
    local _unit = not (units == nil or units.pbgs == nil or #units.pbgs <= 0)
        and units.pbgs[1] or nil
    return Mod_Pbg_ScreenName(
        unit, id, function(pbg) return BP_GetSquadUIInfo(pbg, prace))
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Units_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "units",
        BuildOrder_Check_Units_Activate,
        BuildOrder_Check_Units_Deactivate,
        BuildOrder_Check_Units_GetText,
        BuildOrder_Check_Units_Validate,
        BuildOrder_Check_Units_PollCompletion
    )
end

function BuildOrder_Check_Units_Validate(check)
    local t = check.payload
    return t.ids ~= nil
end

function BuildOrder_Check_Units_Activate(obj, player)
    if _bo_units_data.units[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local state = {
        player = player,
        pbgs = Mod_Pbg_ResolveAll(payload.ids, BP_GetSquadBlueprint),
        minimum = payload.count ~= nil and payload.count or 0,
    }

    if #state.pbgs == 0 then
        print("[UnitCheck] Failed to activate. No pbgs resolved for check="..tostring(obj.check.id).." pbg="..tostring(payload.ids[1]))
        return false
    end
    print("[UnitCheck] Registered check="..tostring(obj.check.id))
    _bo_units_data.units[obj.check.id] = state
    return true
end

function BuildOrder_Check_Units_Deactivate(obj)
    if _bo_units_data.units[obj.check.id] == nil then
        return
    end

    print("[UnitCheck] Requested deactivation of check "..tostring(obj.check.id))
    _bo_units_data.units[obj.check.id] = nil
end

function BuildOrder_Check_Units_GetText(obj)
    print("[UnitCheck] Assembling objective text")
    local payload = obj.check.payload
    local unit_text = UnitName(
        _bo_units_data.units[obj.check.id], payload.id
    )
    local units = _bo_units_data.units[obj.check.id]
    local unit_text = _ScreenNameWrapper(units, payload.id, units~= nil and units.player)
    return Loc_FormatText(
        BO_LOC_StringId(_ACTIVE_UNITS_FORMAT_ID),
        payload.count,
        unit_text
    )
end

-- TODO: Would be ideal if we could do all checks in one go
function BuildOrder_Check_Units_PollCompletion(obj)
    local state = _bo_units_data[obj.check.id]
    if state == nil then
        print("[UnitCheck] No check tracked for child "..obj.check.id)
        return false
    end

    local count = 0
    SGroup_ForEach(
        Player_GetSquads(state.player),
        function(groupId, squadIndex, squad)
            if Squad_GetPlayerOwner(squad) == state.player
                and MatchesAnyBlueprint(
                    state.pbgs, Squad_GetBlueprint(squad))
                and Squad_IsAlive(squad)
            then
                count = count + 1
            end
        end
    )

    print("[UnitCheck] Found "..tostring(count).." units. Want="..tostring(obj.check.payload.count))
    return count >= state.minimum
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
