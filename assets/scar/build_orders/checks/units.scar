-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("dynimport.scar")
import("build_orders/localization.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_units_data = {

}

local _ACTIVE_UNITS_FORMAT_ID = 167

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

-- Similar to built.scar/buildings.scar, but for units
local function ResolveBlueprints(ids)
    local pbgs = {}
    for _, id in ipairs(ids) do
        local found, pbg = BP_GetSquadBlueprint(id)
        if found and pbg ~= nil then
            pbgs[#pbgs + 1] = pbg
        end
    end
    return pbgs
end

-- TODO: Same as built.scar
local function PBGMatches(left, right)
    return left ~= nil and right ~= nil
        and left.PropertyBagGroupID == right.PropertyBagGroupID
        and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
        and left.PropertyBagGroupType == right.PropertyBagGroupType
end

local function MatchesAnyBlueprint(pbgs, blueprint)
    if pbgs == nil then
        return false
    end

    for _, pbg in ipairs(pbgs) do
        if PBGMatches(pbg, blueprint) then
            return true
        end
    end
    return false
end

-- Similar to built.scar/buildings.scar, but for units
local function UnitName(unit, id)
    if unit ~= nil and unit.pbgs ~= nil and #unit.pbgs > 0 then
        local resolved, uiInfo = BP_GetSquadUIInfo(
            unit.pbgs[1], Player_GetRace(unit.player))
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end
    print("Missing localization string for " .. tostring(id))
    return BuildOrder_RawText(tostring(id))
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Units_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "units",
        BuildOrder_Check_Units_Activate,
        BuildOrder_Check_Units_Deactivate,
        BuildOrder_Check_Units_GetText,
        BuildOrder_Check_Units_Validate,
        BuildOrder_Check_Units_PollCompletion
    )
end

function BuildOrder_Check_Units_Validate(check)
    local t = check.payload
    return t.ids ~= nil
end

function BuildOrder_Check_Units_Activate(obj, player)
    if _bo_units_data.units[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local state = {
        player = player,
        pbgs = ResolveBlueprints(payload.ids),
        minimum = payload.count ~= nil and payload.count or 0,
    }

    if #state.pbgs == 0 then
        return false
    end
    _bo_units_data.units[obj.check.id] = state
    return true
end

function BuildOrder_Check_Units_Deactivate(obj)
    if _bo_units_data.units[obj.check.id] == nil then
        return
    end

    _bo_units_data.units[obj.check.id] = nil
end

function BuildOrder_Check_Units_GetText(obj)
    print("Getting text for units check")
    local payload = obj.check.payload
    local unit_text = UnitName(
        _bo_units_data.units[obj.check.id], payload.id
    )
    return Loc_FormatText(
        BO_LOC_StringId(_ACTIVE_UNITS_FORMAT_ID),
        payload.count,
        unit_text
    )
end

-- TODO: Would be ideal if we could do all checks in one go
function BuildOrder_Check_Units_PollCompletion(obj)
    local state = _bo_units_data[obj.check.id]
    if state == nil then
        return false
    end

    local count = 0
    SGroup_ForEach(
        Player_GetSquads(state.player),
        function(groupId, squadIndex, squad)
            if Squad_GetPlayerOwner(squad) == state.player
                and MatchesAnyBlueprint(
                    state.pbgs, Squad_GetBlueprint(squad))
                and Squad_IsAlive(squad)
            then
                count = count + 1
            end
        end
    )
    return count >= state.minimum
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
