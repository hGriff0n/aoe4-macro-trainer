-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("dynimport.scar")
import("build_orders/localization.scar")


-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_ageup_data = {
    age = {},
    num_upgrade_triggers = 0,
    num_building_triggers = 0
}

local _AGE_FORMAT_ID = 161

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

-- Same as produce.scar
local function PBGMatches(left, right)
    return left ~= nil and right ~= nil
        and left.PropertyBagGroupID == right.PropertyBagGroupID
        and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
        and left.PropertyBagGroupType == right.PropertyBagGroupType
end

-- Same as produce.scar
local function MatchesAnyBlueprint(pbgs, blueprint)
    if pbgs == nil then
        return false
    end

    for _, pbg in ipairs(pbgs) do
        if PBGMatches(pbg, blueprint) then
            return true
        end
    end
    return false
end

local function CheckAlreadyCompleted()
    if _bo_ageup_data.age.trigger == "upgrade" then
        for _, pbg in ipairs(_bo_ageup_data.age.pbgs) do
            if Player_HasUpgrade(_bo_ageup_data.age.player, pbg) then
                return true
            end
        end
    else
        return CheckConstructionStarted()
    end

    return false
end

local function CheckConstructionStarted()
    local state = _bo_ageup_data.age
    local found_landmark = false
    EGroup_ForEach(
        Player_GetEntities(state.player),
        function(group, index, entity)
            if Entity_GetPlayerOwner(entity) == state.player
                and Entity_IsBuilding(entity)
                and MatchesAnyBlueprint(
                    state.pbgs, Entity_GetBlueprint(entity))
            then
                found_landmark = true
            end
        end
    )
    return found_landmark
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_AgeUp_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "age_up",
        BuildOrder_Check_AgeUp_Activate,
        BuildOrder_Check_AgeUp_Deactivate,
        BuildOrder_Check_AgeUp_GetText,
        BuildOrder_Check_AgeUp_Validate,
        BuildOrder_Check_AgeUp_PollCompletion
    )
end

function BuildOrder_Check_AgeUp_Validate(check)
    local t = check.payload

    return (t.id ~= nil or t.oneof ~= nil) and t.trigger ~= nil
end

-- child = {
--   obj_id
--   check
--   parent_id
--   completed
--   poll_completion_handle (for non-event only)
-- }
function BuildOrder_Check_AgeUp_Activate(obj, player)
    -- We can only have one age check per step
    if _bo_ageup_data.age ~= nil then
        return false
    end

    local resolver = check.payload.trigger == "upgrade" and
        BP_GetUpgradeBlueprint or BP_GetEntityBlueprint
    local pbgs = BuildOrder_ResolvePayloadBlueprints(
        check.payload, resolver)
    if pbgs == nil or #pbgs == 0 then
        return false
    end

    _bo_ageup_data.age = {
        obj_id = obj.obj_id,
        pbgs = pbgs,
        trigger = check.payload.trigger,
        resolver = resolver,
        player = player
    }

    -- TODO: This has the issue with `obj_id` not be created yet
    local completed = CheckAlreadyCompleted()
    if completed then
        Obj_SetState(obj.obj_id, OS_Complete)
        BuildOrder_Check_AgeUp_Deactivate(obj)
        return true
    end

    if _bo_ageup_data.age.trigger == "upgrade" then
        Rule_AddGlobalEvent(OnUpgradeStart, GE_UpgradeStart)
    else
        Rule_AddGlobalEvent(OnConstructionStart, GE_ConstructionStart)
    end

    return true
end

function BuildOrder_Check_AgeUp_Deactivate(obj)
    if _bo_ageup_data.age == nil then
        return
    end

    if _bo_ageup_data.age.trigger == "upgrade" then
        Rule_RemoveGlobalEvent(OnUpgradeStart)
    else
        Rule_RemoveGlobalEvent(OnConstructionStart)
    end
    _bo_ageup_data.age = nil
end

function BuildOrder_Check_AgeUp_GetText(obj)
    print("Getting text for ageup check")
    local targetKind = "entity"
    if obj.check.payload.trigger == "upgrade" then
        targetKind = "upgrade"
    end
    return Loc_FormatText(
        BUILD_ORDER_LOC_KEYS.ageUp,
        BuildOrder_TargetNames(
            obj.check.payload, targetKind, _bo_ageup_data.age)
    )
end

-- TODO: Needs fix to set state
function OnConstructionStart(event)
    if _bo_ageup_data.age == nil
        or event == nil
        or event.player == nil
        or event.pbg == nil
        or event.entity == nil
        or event.entity.EntityID == nil
    then
        return
    end

    if event.player == _bo_ageup_data.age.player
        and MatchesAnyBlueprint(_bo_ageup_data.age.pbgs, event.pbg)
    then
        Obj_SetState(_bo_ageup_data.age.obj_id, OS_Complete)
        BuildOrder_Check_AgeUp_Deactivate(nil)
    end
end

-- TODO: Needs fix to set state
function OnUpgradeStart(event)
    if _bo_ageup_data.age == nil
        or event == nil
        or event.executer == nil
        or event.upgrade == nil
    then
        return
    end

    -- TODO: Missing `BuildOrder_GetExecuterOwner`
    local owner = GetExecuterOwner(event)
    if owner == _bo_ageup_data.age.player
        -- TODO: Missing `BuildOrder_MatchesAnyBlueprint`
        and MatchesAnyBlueprint(_bo_ageup_data.age.pbgs, event.upgrade)
    then
        Obj_SetState(_bo_ageup_data.age.obj_id, OS_Complete)
        BuildOrder_Check_AgeUp_Deactivate(nil)
    end
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------

-- TODO: Update?
function BuildOrder_TargetNames(payload, kind, context)
    local names = {}
    local joined = false
    if payload.id ~= nil then
        table.insert(names, BuildOrder_GameName(kind, id, context.pbgs[1], context.player))
    elseif payload.oneof ~= nil then
        joined = true
        for i, id in ipairs(payload.oneof) do
            table.insert(names, BuildOrder_GameName(kind, id, context.pbgs[i], context.player))
        end
    end

    -- TODO: Need to implement `JoinLocalized`/etc?
    local result = BuildOrder_JoinLocalized(names, BUILD_ORDER_LOC_KEYS.orJoin)
    if joined then
        return BuildOrder_FormattedArgument(result)
    end
    return result
end

-- TODO: Potentially mergeable with some other files
function BuildOrder_GameName(kind, id, pbg, player)
    if kind == "entity" then
        local resolved, uiInfo = BP_GetEntityUIInfo(pbg)
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    elseif kind == "upgrade" then
        local resolved, uiInfo = BP_GetSquadUIInfo(
            pbg, Player_GetRace(player))
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end

    print("BuildOrder: missing localized " .. tostring(kind) .. " name for " .. tostring(id))
    return BuildOrder_RawText(tostring(id))
end
