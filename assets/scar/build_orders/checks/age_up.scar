-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("build_orders/checks/utils/events.scar")
DynImport("build_orders/checks/utils/pbg.scar")
DynImport("build_orders/checks/utils/queue.scar")
DynImport("utils/localization.scar")

-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------
_bo_ageup_data = nil

local _AGE_FORMAT_ID = 161
local _AGE_LOCATION_FORMAT_ID = 183
local _UPGRADE_ITEM_TYPES = { PITEM_Upgrade, PITEM_PlayerUpgrade }

-----------------------------------------------------------------------
-- Private Implementation
-----------------------------------------------------------------------
local function CheckUpgradeStarted(check_id)
    print("[AgeUpCheck] Checking if player already aged up: check=" .. tostring(check_id))

    local state = _bo_ageup_data
    local started = false
    for _, pbg in ipairs(state.pbgs) do
        if Player_HasUpgrade(state.player, pbg) then
            started = true
        end
    end
    BoQueue_ForEachItem(
        state.player,
        _UPGRADE_ITEM_TYPES,
        function(item)
            if Mod_Pbg_MatchesAny(state.pbgs, item) ~= nil then
                started = true
            end
        end
    )

    if started then
        print("[AgeUpCheck] Player already started aging up: check=" .. tostring(check_id))
    end
    return started
end

local function CheckConstructionStarted(check_id)
    print("[AgeUpCheck] Checking if player already aged up: check=" .. tostring(check_id))

    local state = _bo_ageup_data
    local found_landmark = false
    EGroup_ForEach(
        Player_GetEntities(state.player),
        function(group, index, entity)
            if Entity_IsBuilding(entity)
                and Mod_Pbg_MatchesAny(state.pbgs, Entity_GetBlueprint(entity)) ~= nil
            then
                print("[AgeUpCheck] Player already built landmark: check=" .. tostring(check_id))
                found_landmark = true
            end
        end
    )

    return found_landmark
end

local function switch_trigger(trigger, for_tech, for_build)
    if trigger == "upgrade" then
        return for_tech
    else
        return for_build
    end
end

local function CheckAlreadyCompleted(check_id)
    return switch_trigger(_bo_ageup_data.trigger, CheckUpgradeStarted, CheckConstructionStarted)(check_id)
end

local function IsInvalidConstructionEvent(event)
    return event == nil
        or event.player == nil
        or event.pbg == nil
        or event.entity == nil
        or event.entity.EntityID == nil
end

local function IsInvalidUpgradeEvent(event)
    return event == nil
        or event.executer == nil
        or event.upgrade == nil
end


-----------------------------------------------------------------------
-- Public Interface
-----------------------------------------------------------------------
function BuildOrder_Check_AgeUp_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "age_up",
        BuildOrder_Check_AgeUp_Activate,
        BuildOrder_Check_AgeUp_Deactivate,
        BuildOrder_Check_AgeUp_GetText,
        BuildOrder_Check_AgeUp_Validate,
        nil -- no poll_completion_handle handler
    )
end

function BuildOrder_Check_AgeUp_Validate(check)
    local t = check.payload

    return (t.id ~= nil or t.oneof ~= nil) and t.trigger ~= nil
end

-- obj = {
--   check
--   parent_id
--   completed
--   poll_completion_handle (for non-event only)
-- }
function BuildOrder_Check_AgeUp_Activate(obj, player)
    -- We can only have one age check per step
    if _bo_ageup_data ~= nil then
        return false
    end

    local check = obj.check
    local ids = check.payload.oneof or { check.payload.id }
    local resolver = switch_trigger(check.payload.trigger, BP_GetUpgradeBlueprint, BP_GetEntityBlueprint)
    local pbgs = Mod_Pbg_ResolveAll(ids, resolver)
    if pbgs == nil or #pbgs == 0 then
        -- TODO: table.concat instead
        print("[AgeUpCheck] Failed to resolve pbg: check=" .. tostring(check.id) .. " pbg=" .. tostring(ids))
        return false
    end

    print("[AgeUpCheck] Registered check=" .. tostring(obj.check.id))
    _bo_ageup_data = {
        id = check.id,
        pbgs = pbgs,
        trigger = check.payload.trigger,
        resolver = resolver,
        player = player
    }
    if CheckAlreadyCompleted(check.id) then
        print("[AgeUpCheck] Already completed check=" .. tostring(check.id))
        BuildOrder_Objectives_MarkComplete(check.id, true)
        _bo_ageup_data = nil
        return true
    end

    switch_trigger(
        _bo_ageup_data.trigger,
        function()
            Rule_AddGlobalEvent(BuildOrder_Check_AgeUp_OnUpgradeStart, GE_UpgradeStart)
        end,
        function()
            Rule_AddGlobalEvent(BuildOrder_Check_AgeUp_OnConstructionStart, GE_ConstructionStart)
        end
    )()

    return true
end

function BuildOrder_Check_AgeUp_Deactivate(obj)
    if _bo_ageup_data == nil then
        return
    end

    switch_trigger(
        _bo_ageup_data.trigger,
        function()
            Rule_RemoveGlobalEvent(BuildOrder_Check_AgeUp_OnUpgradeStart)
        end,
        function()
            Rule_RemoveGlobalEvent(BuildOrder_Check_AgeUp_OnConstructionStart)
        end
    )()

    print("[AgeUpCheck] Deleted check=" .. tostring(_bo_ageup_data.id))
    _bo_ageup_data = nil
end

-- TODO: Needs to support vilager hints (can we reuse upgrades and built respectively?)
function BuildOrder_Check_AgeUp_GetText(obj)
    print("[AgeUpCheck] Assembling objective text")
    local payload = obj.check.payload
    local target = Mod_Pbg_JoinScreenNames(
        payload.oneof or { payload.id },
        switch_trigger(payload.trigger, BP_GetUpgradeBlueprint, BP_GetEntityBlueprint),
        switch_trigger(payload.trigger, BP_GetUpgradeUIInfo, BP_GetEntityUIInfo),
        "/"
    )
    if payload.location == nil then
        return Loc_FormatText(BoLoc_ModStringId(_AGE_FORMAT_ID), target)
    end
    return Loc_FormatText(
        BoLoc_ModStringId(_AGE_LOCATION_FORMAT_ID),
        target,
        BoLoc_String(payload.location)
    )
end

function BuildOrder_Check_AgeUp_OnConstructionStart(event)
    print("[AgeUpCheck] Received construction event: " .. tostring(event))
    if _bo_ageup_data == nil then
        print("[AgeUpCheck] No active check but listener wasn't deregistered. Ignoring and removing listener.")
        Rule_RemoveGlobalEvent(BuildOrder_Check_AgeUp_OnConstructionStart)
        return
    end

    if IsInvalidConstructionEvent(event) or event.player ~= _bo_ageup_data.player then
        return
    end

    local match = Mod_Pbg_MatchesAny(_bo_ageup_data.pbgs, event.pbg)
    if match ~= nil then
        print("[AgeUpCheck] Expected ageup construction started. Marking " .. tostring(_bo_ageup_data.id) .. " complete")
        BuildOrder_Objectives_MarkComplete(_bo_ageup_data.id, true)
        BuildOrder_Check_AgeUp_Deactivate(nil)
    end
end

function BuildOrder_Check_AgeUp_OnUpgradeStart(event)
    print("[AgeUpCheck] Received upgrade event: " .. tostring(event))
    if _bo_ageup_data == nil then
        print("[AgeUpCheck] Age Up listener wasn't deregistered. This should never happen. Removing listener now.")
        Rule_RemoveGlobalEvent(BuildOrder_Check_AgeUp_OnUpgradeStart)
        return
    end

    if IsInvalidUpgradeEvent(event) or BoEvents_GetExecuterOwner(event) ~= _bo_ageup_data.player then
        return
    end

    if Mod_Pbg_MatchesAny(_bo_ageup_data.pbgs, event.upgrade) ~= nil then
        print("[AgeUpCheck] Expected ageup upgrade started. Marking " .. tostring(_bo_ageup_data.id) .. " complete")
        BuildOrder_Objectives_MarkComplete(_bo_ageup_data.id, true)
        BuildOrder_Check_AgeUp_Deactivate(nil)
    end
end

