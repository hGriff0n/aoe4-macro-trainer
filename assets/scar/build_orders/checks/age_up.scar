AGE_UP_STATE = {}
AGE_UP_CONSTRUCTION_EVENTS = false
AGE_UP_UPGRADE_EVENTS = false
AGE_UP_SCAN_STATE = nil

AGE_UP_UPGRADE_CIVS = {
	abbasid = true,
	ayyubids = true,
	templar = true,
	golden_horde = true,
}

AGE_UP_SUPPORTED_CIVS = {
	abbasid = true,
	ayyubids = true,
	byzantines = true,
	chinese = true,
	delhi = true,
	english = true,
	french = true,
	golden_horde = true,
	house_of_lancaster = true,
	hre = true,
	japanese = true,
	jeanne_darc = true,
	jin_dynasty = true,
	macedonian_dynasty = true,
	malians = true,
	mongols = true,
	order_of_the_dragon = true,
	ottomans = true,
	rus = true,
	sengoku_daimyo = true,
	templar = true,
	tughlaq_dynasty = true,
	zhu_xi = true,
}

function AgeUp_PBGsEqual(left, right)
	return left ~= nil and right ~= nil
		and left.PropertyBagGroupID == right.PropertyBagGroupID
		and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
		and left.PropertyBagGroupType == right.PropertyBagGroupType
end

function AgeUp_UsesUpgradeEvent(civ)
	if civ == nil or AGE_UP_SUPPORTED_CIVS[civ] ~= true then
		return nil
	end
	return AGE_UP_UPGRADE_CIVS[civ] == true
end

local function AgeUp_ResolvePBGs(payload, civ)
	local usesUpgradeEvent = AgeUp_UsesUpgradeEvent(civ)
	if usesUpgradeEvent == nil then
		return nil
	end

	local resolver = BP_GetEntityBlueprint
	if usesUpgradeEvent then
		resolver = BP_GetUpgradeBlueprint
	end

	local pbgs = {}
	if payload.id ~= nil then
		table.insert(pbgs, resolver(payload.id))
	else
		for _, identifier in ipairs(payload.oneof) do
			table.insert(pbgs, resolver(identifier))
		end
	end
	return pbgs
end

function AgeUp_MatchesPBG(pbgs, pbg)
	for _, candidate in ipairs(pbgs) do
		if AgeUp_PBGsEqual(candidate, pbg) then
			return true
		end
	end
	return false
end

function AgeUp_CheckLandmarkEntity(group, index, entity)
	local state = AGE_UP_SCAN_STATE
	if state == nil then
		return false
	end
	-- Player_GetEntities is player-scoped, but retain the owner guard for converted entities.
	if Entity_GetPlayerOwner(entity) ~= state.player then
		return false
	end
	if Entity_IsBuilding(entity)
		and Entity_GetBuildingProgress(entity) >= 1.0
		and AgeUp_MatchesPBG(state.pbgs, Entity_GetBlueprint(entity)) then
		state.baselineComplete = true
		return true
	end
	return false
end

local function AgeUp_HasCompletedUpgrade(state)
	for _, pbg in ipairs(state.pbgs) do
		if Player_HasUpgrade(state.player, pbg) then
			return true
		end
	end
	return false
end

local function AgeUp_HasCompletedLandmark(state)
	state.baselineComplete = false
	AGE_UP_SCAN_STATE = state
	EGroup_ForEach(Player_GetEntities(state.player), AgeUp_CheckLandmarkEntity)
	AGE_UP_SCAN_STATE = nil
	return state.baselineComplete
end

local function AgeUp_TryComplete(state)
	if state == nil or state.completed or state.unsupported then
		return
	end

	local complete = false
	if AgeUp_UsesUpgradeEvent(state.civ) then
		complete = AgeUp_HasCompletedUpgrade(state)
	else
		complete = AgeUp_HasCompletedLandmark(state)
	end
	if complete then
		state.completed = true
		BuildOrder_SetCheckComplete(state.checkID, true)
	end
end

function AgeUp_OnConstructionStart(context)
	if context == nil or context.player == nil or context.pbg == nil or context.entity == nil then
		return
	end
	local entityID = context.entity.EntityID
	if entityID == nil then
		return
	end

	local completedCheckIDs = {}
	for checkID, state in pairs(AGE_UP_STATE) do
		if state.completed == false and state.unsupported == false
			and AgeUp_UsesUpgradeEvent(state.civ) == false then
			if context.player ~= state.player then
				-- Never allow opponent construction to satisfy a local-player objective.
			elseif AgeUp_MatchesPBG(state.pbgs, context.pbg)
				and state.seenFoundations[entityID] ~= true then
				state.seenFoundations[entityID] = true
				state.completed = true
				table.insert(completedCheckIDs, checkID)
			end
		end
	end
	for _, checkID in ipairs(completedCheckIDs) do
		BuildOrder_SetCheckComplete(checkID, true)
	end
	AgeUp_UpdateObservers()
end

local function AgeUp_GetExecuterOwner(context)
	if context == nil or context.executer == nil then
		return nil
	end
	if context.executer.PlayerID ~= nil then
		return context.executer
	end
	if context.executer.EntityID ~= nil then
		return Entity_GetPlayerOwner(context.executer)
	end
	return nil
end

function AgeUp_OnUpgradeStart(context)
	if context == nil or context.executer == nil or context.upgrade == nil then
		return
	end

	local owner = AgeUp_GetExecuterOwner(context)
	local completedCheckIDs = {}
	for checkID, state in pairs(AGE_UP_STATE) do
		if state.completed == false and state.unsupported == false
			and AgeUp_UsesUpgradeEvent(state.civ) then
			if owner ~= state.player then
				-- Never allow opponent research to satisfy a local-player objective.
			elseif AgeUp_MatchesPBG(state.pbgs, context.upgrade) then
				state.completed = true
				table.insert(completedCheckIDs, checkID)
			end
		end
	end
	for _, checkID in ipairs(completedCheckIDs) do
		BuildOrder_SetCheckComplete(checkID, true)
	end
	AgeUp_UpdateObservers()
end

function AgeUp_UpdateObservers()
	local needsConstructionEvents = false
	local needsUpgradeEvents = false
	for _, state in pairs(AGE_UP_STATE) do
		if state.completed == false and state.unsupported == false then
			if AgeUp_UsesUpgradeEvent(state.civ) then
				needsUpgradeEvents = true
			else
				needsConstructionEvents = true
			end
		end
	end

	if needsConstructionEvents and not AGE_UP_CONSTRUCTION_EVENTS then
		Rule_AddGlobalEvent(AgeUp_OnConstructionStart, GE_ConstructionStart)
		AGE_UP_CONSTRUCTION_EVENTS = true
	elseif not needsConstructionEvents and AGE_UP_CONSTRUCTION_EVENTS then
		Rule_RemoveGlobalEvent(AgeUp_OnConstructionStart)
		AGE_UP_CONSTRUCTION_EVENTS = false
	end

	if needsUpgradeEvents and not AGE_UP_UPGRADE_EVENTS then
		Rule_AddGlobalEvent(AgeUp_OnUpgradeStart, GE_UpgradeStart)
		AGE_UP_UPGRADE_EVENTS = true
	elseif not needsUpgradeEvents and AGE_UP_UPGRADE_EVENTS then
		Rule_RemoveGlobalEvent(AgeUp_OnUpgradeStart)
		AGE_UP_UPGRADE_EVENTS = false
	end
end

local function AgeUp_Activate(check, objectiveID, context)
	if context == nil or context.localPlayer == nil then
		return
	end
	if AGE_UP_STATE[check.id] ~= nil then
		return
	end

	local civ = context.civ
	local usesUpgradeEvent = AgeUp_UsesUpgradeEvent(civ)
	local pbgs = AgeUp_ResolvePBGs(check.payload, civ)
	local unsupported = usesUpgradeEvent == nil or pbgs == nil
	if unsupported then
		print("AgeUp: unsupported civilization " .. tostring(civ))
	end

	AGE_UP_STATE[check.id] = {
		checkID = check.id,
		objectiveID = objectiveID,
		civ = civ,
		player = context.localPlayer,
		pbgs = pbgs,
		usesUpgradeEvent = usesUpgradeEvent,
		unsupported = unsupported,
		completed = false,
		seenFoundations = {},
	}
	AgeUp_TryComplete(AGE_UP_STATE[check.id])
	AgeUp_UpdateObservers()
end

local function AgeUp_Deactivate(check, objectiveID, context)
	if AGE_UP_STATE[check.id] == nil then
		return
	end
	AGE_UP_STATE[check.id] = nil
	AgeUp_UpdateObservers()
end

BuildOrder_RegisterHandler("age_up", {
	activate = AgeUp_Activate,
	deactivate = AgeUp_Deactivate,
})
