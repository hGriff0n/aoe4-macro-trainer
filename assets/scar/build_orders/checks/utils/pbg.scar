
local _pbg_cache = {}

function Mod_Pbg_Resolve(id, blueprint_getter)
    local pbgs = {}
    if _pbg_cache[id] == nil then
        local pbg = blueprint_getter(id)
        if pbg ~= nil then
            _pbg_cache[id] = pbg
        end
    end
    return _pbg_cache[id]
end

function Mod_Pbg_ResolveAll(ids, blueprint_getter)
    local pbgs = {}
    for _, id in ipairs(ids) do
        local _pbg = Mod_Pbg_Resolve(id, blueprint_getter)
        if _pbg ~= nil then
            pbgs[#pbgs+1] = _pbg
        end
    end
    return pbgs
end

function Mod_Pbg_Equals(left, right)
    return left ~= nil and right ~= nil
        and left.PropertyBagGroupID == right.PropertyBagGroupID
        and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
        and left.PropertyBagGroupType == right.PropertyBagGroupType
end

function Mod_Pbg_MatchesAny(pbgs, blueprint)
    for i, pbg in ipairs(pbgs ~= nil and pbgs or {}) do
        if Mod_Pbg_Equals(pbg, blueprint) then
            return i
        end
    end
    return nil
end

-- TODO: There's probably some way to identify building/etc. from pbg
-- `player` is optional, defaulting to nil if not provided
function Mod_Pbg_ScreenName(id, pbg, ui_accessor, player)
    local prace = nil
    if player ~= nil then
        prace = Player_GetRace(player)
    end

    if pbg ~= nil then
        -- Note: "Extra" arguments are ignored if `ui_accessor` takes only 1 arg
        local resolved, uiInfo = ui_accessor(pbg, prace)
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end

    print("Missing localization string for " .. tostring(id))
    return BoLoc_String(id)
end
