import("utils/dynimport.scar")

DynImport("utils/localization.scar")

local _pbg_cache = {}

function Mod_Pbg_Resolve(id, blueprint_getter)
    local pbgs = {}
    if _pbg_cache[id] == nil then
        local pbg = blueprint_getter(id)
        if pbg ~= nil then
            _pbg_cache[id] = pbg
        end
    end
    return _pbg_cache[id]
end

function Mod_Pbg_ResolveAll(ids, blueprint_getter)
    local pbgs = {}
    for _, id in ipairs(ids) do
        local _pbg = Mod_Pbg_Resolve(id, blueprint_getter)
        if _pbg ~= nil then
            pbgs[#pbgs + 1] = _pbg
        end
    end
    return pbgs
end

function Mod_Pbg_Equals(left, right)
    return left ~= nil and right ~= nil
        and left.PropertyBagGroupID == right.PropertyBagGroupID
        and left.PropertyBagGroupModPackID == right.PropertyBagGroupModPackID
        and left.PropertyBagGroupType == right.PropertyBagGroupType
end

function Mod_Pbg_MatchesAny(pbgs, blueprint)
    for i, pbg in ipairs(pbgs ~= nil and pbgs or {}) do
        if Mod_Pbg_Equals(pbg, blueprint) then
            return i
        end
    end
    return nil
end

-- TODO: There's probably some way to identify building/etc. from pbg
-- `player` is optional, defaulting to nil if not provided
function Mod_Pbg_ScreenName(id, pbg, ui_accessor, player)
    local prace = nil
    if player ~= nil then
        prace = Player_GetRace(player)
    end

    if pbg ~= nil then
        local uiInfo = prace == nil and ui_accessor(pbg) or ui_accessor(pbg, prace)
        if uiInfo ~= nil and uiInfo.screenName ~= nil then
            return uiInfo.screenName
        end
    end

    print("[PBG] Missing localization string for " .. tostring(id))
    return BoLoc_String(id)
end

-- Joins the screen names of `ids` with `delim`, dropping duplicates
-- since every age's version of a building/tech shares one name
function Mod_Pbg_JoinScreenNames(ids, blueprint_getter, ui_accessor, delim)
    local names = {}
    local seen = {}
    for _, id in ipairs(ids) do
        local name = Mod_Pbg_ScreenName(id, Mod_Pbg_Resolve(id, blueprint_getter), ui_accessor)
        -- LocStrings with the same text aren't `==`, so compare the text instead
        local text = BoLoc_IsLocString(name) and name.LocString or tostring(name)
        if not seen[text] then
            seen[text] = true
            names[#names + 1] = name
        end
    end
    return BoLoc_JoinStrings(names, delim)
end
