-----------------------------------------------------------------------
-- Imports
-----------------------------------------------------------------------
import("utils/dynimport.scar")

DynImport("build_orders/localization.scar")
DynImport("build_orders/checks/uitls/pbg.scar")

-----------------------------------------------------------------------
-- Data
-----------------------------------------------------------------------

_bo_built_data = {
    buildings = {},
    event_registered = false
}
BUILD_MANY_FORMAT_ID = 160

-----------------------------------------------------------------------
-- Local Helper Functions
-----------------------------------------------------------------------

local function IsInvalidEvent(event)
    return event == nil or event.player == nil or event.pbg == nil
        or event.entity == nil or event.entity.EntityID == nil
end

local function DeactivateCheck(check_id)
    if _bo_built_data.buildings[check_id] ~= nil then
        print("[BuiltCheck] Deleted check="..tostring(obj.check.id))
        _bo_built_data.buildings[check_id] = nil
    end

    -- Only remove the event handler if all checks are deactivated
    -- since a single step can have multiple checks of the same kind
    if next(_bo_built_data.buildings) == nil
        and _bo_built_data.event_registered
    then
        print("[BuiltCheck] All checks deactiated, removing listener")
        Rule_RemoveGlobalEvent(BuildOrder_Check_Built_EventHandle)
        _bo_built_data.event_registered = false
    end
end

-----------------------------------------------------------------------
-- Mod Interface
-----------------------------------------------------------------------

function BuildOrder_Check_Built_Register()
    BuildOrder_Objectives_RegisterCheckHandlers(
        "built",
        BuildOrder_Check_Built_Activate,
        BuildOrder_Check_Built_Deactivate,
        BuildOrder_Check_Built_GetText,
        BuildOrder_Check_Built_Validate,
        nil
    )
end

function BuildOrder_Check_Built_Validate(check)
    local t = check.payload
    return t.id ~= nil
end

function BuildOrder_Check_Built_Activate(obj, player)
    if _bo_built_data.buildings[obj.check.id] ~= nil then
        return false
    end

    local payload = obj.check.payload
    local pbg = Mod_Pbg_Resolve(payload.id, BP_GetEntityBlueprint)
    if pbg == nil then
        print("[BuiltCheck] Failed to resolve pbg: check="..tostring(obj.check.id).." pbg="..tostring(obj.check.payload.id))
        return false
    end

    print("[BuiltCheck] Registered check="..tostring(obj.check.id))
    _bo_built_data.buildings[obj.check.id] = {
        obj_id = obj.obj_id,
        pbg = pbgs[1],
        count = obj.check.payload.count,
        player = player,
    }

    if not _bo_built_data.event_registered then
        print("[BuiltCheck] Adding event listener: check="..tostring(obj.check.id))
        _bo_built_data.event_registered = true
        Rule_AddGlobalEvent(
            BuildOrder_Check_Built_EventHandle,
            GE_ConstructionComplete
        )
    end
    return true
end

function BuildOrder_Check_Built_Deactivate(obj)
    print("[BuiltCheck] Requested deactivation of check "..tostring(obj.check.id))
    if _bo_built_data.event_registered then
        DeactivateCheck(obj.check.id)
    end
end

function BuildOrder_Check_Built_GetText(obj)
    print("[BuiltCheck] Assembling objective text")
    local payload = obj.check.payload
    local building = _bo_built_data.buildings[obj.check.id]
    local building_name = Mod_Pbg_ScreenName(
        building~= nil and building.pbg or nil,
        payload.id,
        BP_GetEntityUIInfo
    )
    return Loc_FormatText(BO_LOC_StringId(BUILD_MANY_FORMAT_ID), payload.count, building)
end

-- We have one event handle active for all checks in a given step
-- but we call activate/deactivate for each one
function BuildOrder_Check_Built_EventHandle(event)
    print("[BuiltCheck] Received event: "..tostring(event))
    if IsInvalidEvent(event) then
        print("[BuiltCheck] No/invalid check tracked for child "..tostring(obj.check.id))
        return
    end

    for check_id, state in pairs(_bo_built_data.buildings) do
        if event.player == state.player
            and Mod_Pbg_Equals(state.pbg, event.pbg)
        then
            print("[BuiltCheck] Found matching listener")
            state.count = state.count - 1
        end

        if state.count == 0 then
            print("[BuiltCheck] Expected num events seen. Marking "..tostring(state.obj_id).." complete")
            Obj_SetState(state.obj_id, OS_Complete)
            DeactivateCheck(check_id)
        end
    end
end

-----------------------------------------------------------------------
-- Mod Implementation
-----------------------------------------------------------------------
