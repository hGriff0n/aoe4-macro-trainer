
function Mod_Debug_PrintTable(t, indentation)
	indentation = indentation or ""
	for k, v in pairs(t) do
		local value = tostring(v)
		if type(v) == "table" then
			print(indentation .. k .. " = {")
			Mod_Debug_PrintTable(v, indentation .. "  ")
			print(indentation .. "}")
		else
			print(indentation .. k .. " = " .. value)
		end
	end
end

function Mod_Debug_PrintKeys(t)
	local s = {}
	for k, _ in pairs(t) do
		s[#s + 1] = k
	end
	return table.concat(s, ", ")
end
